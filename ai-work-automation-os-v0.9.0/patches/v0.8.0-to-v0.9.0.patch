-function integerEnvironment(
-  name: string,
-  fallback: number,
-  minimum: number,
-  maximum: number
-): number {
-  const raw = process.env[name]?.trim();
-  const value = raw ? Number(raw) : fallback;
-
-  if (!Number.isInteger(value) || value < minimum || value > maximum) {
-    throw new Error(`invalid_environment_variable:${name}`);
-  }
-
-  return value;
-}
-
-function tokenEnvironment(name: string, fallback: string): string {
-  const value = process.env[name]?.trim() || fallback;
-
-  if (!/^[A-Za-z0-9._:@/-]{1,200}$/.test(value)) {
-    throw new Error(`invalid_environment_variable:${name}`);
-  }
-
-  return value;
-}
-
-export function getGraphRuntimeMode(): GraphRuntimeMode {
-  const value = process.env.GRAPH_RUNTIME_MODE?.trim() || "legacy";
-
-  if (!graphRuntimeModes.includes(value as GraphRuntimeMode)) {
-    throw new Error("invalid_environment_variable:GRAPH_RUNTIME_MODE");
-  }
-
-  return value as GraphRuntimeMode;
-}
