-function baseReservationForNode(node: GraphNodeSpec): GraphUsageReservation {
-  if (
-    node.handlerId !== "direct_execute" &&
-    node.handlerId !== "execute" &&
-    node.handlerId !== "develop"
-  ) {
-    return zeroUsage();
-  }
-
-  return {
-    calls: 1,
-    inputTokens: integerEnvironment(
-      "GRAPH_AGENT_RESERVE_INPUT_TOKENS",
-      4_000,
-      0,
-      1_000_000
-    ),
-    outputTokens: integerEnvironment(
-      "GRAPH_AGENT_RESERVE_OUTPUT_TOKENS",
-      4_000,
-      0,
-      1_000_000
-    ),
-    costMicros: String(
-      integerEnvironment(
-        "GRAPH_AGENT_RESERVE_COST_MICROS",
-        0,
-        0,
-        1_000_000_000
-      )
-    )
-  };
-}
-
-function addReservations(
-  ...values: readonly GraphUsageReservation[]
-): GraphUsageReservation {
-  return values.reduce<GraphUsageReservation>(
-    (total, value) => ({
-      calls: total.calls + value.calls,
-      inputTokens: total.inputTokens + value.inputTokens,
-      outputTokens: total.outputTokens + value.outputTokens,
-      costMicros: (
-        BigInt(total.costMicros) + BigInt(value.costMicros)
-      ).toString(10)
-    }),
-    zeroUsage()
-  );
-}
-
-type ConfiguredRoleDescriptor = {
-  role: LiveGraphRole;
-  maxOutputTokens: number;
-};
-
-function configuredRoleDescriptor(
-  node: GraphNodeSpec,
-  state: GraphStateV1
-): ConfiguredRoleDescriptor | null {
-  switch (node.handlerId) {
-    case "research":
-      return { role: "researcher", maxOutputTokens: 6_000 };
-    case "plan":
-      return { role: "planner", maxOutputTokens: 6_000 };
-    case "execute":
-      return { role: "specialist", maxOutputTokens: 8_000 };
-    case "develop":
-      return { role: "developer", maxOutputTokens: 8_000 };
-    case "verify":
-      return {
-        role: "verifier",
-        maxOutputTokens:
-          state.route.verificationProfile === "adversarial" ? 8_000 : 5_000
-      };
-    case "synthesize":
-      return { role: "synthesizer", maxOutputTokens: 6_000 };
-    default:
-      return null;
-  }
-}
-
-function remainingGraphCostMicros(graphRun: GraphRun): string {
-  const remaining =
-    graphRun.costLimitMicros -
-    graphRun.costUsedMicros -
-    graphRun.costReservedMicros;
-  return (remaining > 0n ? remaining : 0n).toString(10);
-}
-
-function roleReservationForNode(input: {
-  graphRun: GraphRun;
-  node: GraphNodeSpec;
-  state: GraphStateV1;
-}): GraphUsageReservation | null {
-  const descriptor = configuredRoleDescriptor(input.node, input.state);
-  if (!descriptor || !shouldExecuteConfiguredGraphRole(descriptor.role)) {
-    return null;
-  }
-  const reservation = estimateConfiguredGraphRoleReservation({
-    role: descriptor.role,
-    modelClass: input.state.route.modelClass,
-    verificationProfile: input.state.route.verificationProfile,
-    estimatedInputTokens: integerEnvironment(
-      "GRAPH_ROLE_ESTIMATED_INPUT_TOKENS",
-      4_000,
-      1,
-      1_000_000
-    ),
-    maxOutputTokens: descriptor.maxOutputTokens,
-    remainingCostMicros: remainingGraphCostMicros(input.graphRun)
-  });
-  if (!reservation && graphRoleRuntimeConfiguration().mode === "live") {
-    throw new GraphRuntimeError("graph_role_reservation_unavailable", 409);
-  }
-  if (!reservation) return null;
-  const maximumAttempts = integerEnvironment(
-    "GRAPH_ROLE_MAX_ATTEMPTS",
-    2,
-    1,
-    5
-  );
-  return {
-    calls: reservation.calls * maximumAttempts,
-    inputTokens: reservation.inputTokens * maximumAttempts,
-    outputTokens: reservation.outputTokens * maximumAttempts,
-    costMicros: (
-      BigInt(reservation.costMicros) * BigInt(maximumAttempts)
-    ).toString(10)
-  };
-}
-
-function validateUsageWithinReservation(
-  usage: GraphUsage,
-  reservation: GraphUsageReservation
-): void {
-  if (
-    usage.calls > reservation.calls ||
-    usage.inputTokens > reservation.inputTokens ||
-    usage.outputTokens > reservation.outputTokens ||
-    BigInt(usage.costMicros) > BigInt(reservation.costMicros)
-  ) {
-    throw new GraphRuntimeError("graph_usage_exceeded_reservation", 409);
-  }
-}
-
-function reservationIsZero(value: GraphUsageReservation): boolean {
-  return (
-    value.calls === 0 &&
-    value.inputTokens === 0 &&
-    value.outputTokens === 0 &&
-    value.costMicros === "0"
-  );
-}
-
-async function outstandingNodeReservation(
-  tx: Prisma.TransactionClient,
-  nodeRunId: string
-): Promise<GraphUsageReservation> {
-  const entries = await tx.graphBudgetEntry.findMany({
-    where: {
-      nodeRunId,
-      kind: { in: ["reserve", "release"] }
-    },
-    select: {
-      kind: true,
-      callDelta: true,
-      inputTokenDelta: true,
-      outputTokenDelta: true,
-      amountMicros: true
-    }
-  });
-  let calls = 0;
-  let inputTokens = 0;
-  let outputTokens = 0;
-  let costMicros = 0n;
-
-  for (const entry of entries) {
-    const direction = entry.kind === "reserve" ? 1 : -1;
-    calls += direction * entry.callDelta;
-    inputTokens += direction * entry.inputTokenDelta;
-    outputTokens += direction * entry.outputTokenDelta;
-    costMicros += BigInt(direction) * entry.amountMicros;
-  }
-
-  if (calls < 0 || inputTokens < 0 || outputTokens < 0 || costMicros < 0n) {
-    throw new GraphRuntimeError("graph_budget_ledger_corrupted", 500);
-  }
-
-  return {
-    calls,
-    inputTokens,
-    outputTokens,
-    costMicros: costMicros.toString(10)
-  };
-}
-
-type RecoveredRoleUsage = {
-  usage: GraphUsage;
-  invocationCount: number;
-};
-
-function parseRecoveredRoleUsage(value: string | null): GraphUsage {
-  if (!value) return zeroUsage();
-  try {
-    const parsed = JSON.parse(value) as Partial<GraphUsage>;
-    if (
-      !Number.isSafeInteger(parsed.calls) ||
-      (parsed.calls ?? -1) < 0 ||
-      !Number.isSafeInteger(parsed.inputTokens) ||
-      (parsed.inputTokens ?? -1) < 0 ||
-      !Number.isSafeInteger(parsed.outputTokens) ||
-      (parsed.outputTokens ?? -1) < 0 ||
-      typeof parsed.costMicros !== "string" ||
-      !/^\d{1,30}$/.test(parsed.costMicros)
-    ) {
-      throw new Error("invalid_usage");
-    }
-    return {
-      calls: parsed.calls as number,
-      inputTokens: parsed.inputTokens as number,
-      outputTokens: parsed.outputTokens as number,
-      costMicros: BigInt(parsed.costMicros).toString(10)
-    };
-  } catch {
-    throw new GraphRuntimeError("graph_role_usage_corrupted", 500);
-  }
-}
-
-async function settleRecoveredRoleUsage(input: {
-  tx: Prisma.TransactionClient;
-  graphRunId: string;
-  releases: readonly {
-    nodeRunId: string;
-    reservation: GraphUsageReservation;
-  }[];
-  reason: string;
-}): Promise<RecoveredRoleUsage> {
-  if (input.releases.length === 0) {
-    return { usage: zeroUsage(), invocationCount: 0 };
-  }
-  const reservationByNode = new Map(
-    input.releases.map((item) => [item.nodeRunId, item.reservation] as const)
-  );
-  const invocations = await input.tx.graphRoleInvocation.findMany({
-    where: {
-      graphRunId: input.graphRunId,
-      nodeRunId: { in: [...reservationByNode.keys()] },
-      budgetAccountedAt: null,
-      status: { in: ["completed", "failed"] }
-    },
-    orderBy: [{ createdAt: "asc" }, { id: "asc" }]
-  });
-  const usageByNode = new Map<string, GraphUsage>();
-  let total = zeroUsage();
-
-  for (const invocation of invocations) {
-    const usage = parseRecoveredRoleUsage(invocation.usageJson);
-    const current = usageByNode.get(invocation.nodeRunId) ?? zeroUsage();
-    const combined = {
-      calls: current.calls + usage.calls,
-      inputTokens: current.inputTokens + usage.inputTokens,
-      outputTokens: current.outputTokens + usage.outputTokens,
-      costMicros: (
-        BigInt(current.costMicros) + BigInt(usage.costMicros)
-      ).toString(10)
-    };
-    const reservation = reservationByNode.get(invocation.nodeRunId);
-    if (!reservation) {
-      throw new GraphRuntimeError("graph_role_reservation_missing", 500);
-    }
-    validateUsageWithinReservation(combined, reservation);
-    usageByNode.set(invocation.nodeRunId, combined);
-    total = {
-      calls: total.calls + usage.calls,
-      inputTokens: total.inputTokens + usage.inputTokens,
-      outputTokens: total.outputTokens + usage.outputTokens,
-      costMicros: (
-        BigInt(total.costMicros) + BigInt(usage.costMicros)
-      ).toString(10)
-    };
-
-    await input.tx.graphBudgetEntry.create({
-      data: {
-        graphRunId: input.graphRunId,
-        nodeRunId: invocation.nodeRunId,
-        idempotencyKey: `${invocation.id}:recovered_role_actual`,
-        kind: "actual",
-        callDelta: usage.calls,
-        inputTokenDelta: usage.inputTokens,
-        outputTokenDelta: usage.outputTokens,
-        amountMicros: BigInt(usage.costMicros),
-        metadataJson: graphCanonicalJson({
-          reason: input.reason,
-          roleInvocationId: invocation.id,
-          provider: invocation.provider,
-          model: invocation.model,
-          attemptCount: invocation.attemptCount
-        })
-      }
-    });
-    const accounted = await input.tx.graphRoleInvocation.updateMany({
-      where: {
-        id: invocation.id,
-        budgetAccountedAt: null,
-        status: invocation.status
-      },
-      data: { budgetAccountedAt: new Date() }
-    });
-    if (accounted.count !== 1) {
-      throw new GraphRuntimeError("graph_role_budget_contention", 409);
-    }
-  }
-
-  return { usage: total, invocationCount: invocations.length };
-}
-
-async function touchMissionRunFence(
-  tx: Prisma.TransactionClient,
-  fence: GraphRunFence
-): Promise<void> {
-  const touched = await tx.missionRun.updateMany({
-    where: {
-      id: fence.missionRunId,
-      status: "running",
-      leaseOwner: fence.workerId,
-      leaseEpoch: fence.leaseEpoch,
-      leaseExpiresAt: { gt: new Date() }
-    },
-    data: { fenceCheckCount: { increment: 1 } }
-  });
-
-  if (touched.count !== 1) throw new GraphFenceLostError();
-}
