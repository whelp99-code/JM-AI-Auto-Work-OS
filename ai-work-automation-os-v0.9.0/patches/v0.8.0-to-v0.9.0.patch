-  }
-
-  if (results.length > maximumFanOut) {
-    throw new Error("graph_fan_out_limit_exceeded");
-  }
-
-  const seen = new Set<string>();
-  const ordered = results.map((result) => graphClone(result));
-
-  for (const result of ordered) {
-    if (!/^[A-Za-z0-9._:@-]{1,120}$/.test(result.instanceKey)) {
-      throw new Error("invalid_graph_branch_instance_key");
-    }
-
-    if (seen.has(result.instanceKey)) {
-      throw new Error("duplicate_graph_branch_instance_key");
-    }
-
-    seen.add(result.instanceKey);
-  }
-
-  return ordered.sort((a, b) => a.instanceKey.localeCompare(b.instanceKey));
-}
-
-export function sumGraphUsage(values: readonly GraphUsage[]): GraphUsage {
-  let calls = 0;
-  let inputTokens = 0;
-  let outputTokens = 0;
-  let costMicros = 0n;
-
-  for (const value of values) {
-    if (
-      !Number.isInteger(value.calls) ||
-      value.calls < 0 ||
-      !Number.isInteger(value.inputTokens) ||
-      value.inputTokens < 0 ||
-      !Number.isInteger(value.outputTokens) ||
-      value.outputTokens < 0 ||
-      !/^(0|[1-9][0-9]*)$/.test(value.costMicros)
-    ) {
-      throw new Error("invalid_graph_usage");
-    }
-
-    calls += value.calls;
-    inputTokens += value.inputTokens;
-    outputTokens += value.outputTokens;
-    costMicros += BigInt(value.costMicros);
-  }
-
-  return {
-    calls,
-    inputTokens,
-    outputTokens,
