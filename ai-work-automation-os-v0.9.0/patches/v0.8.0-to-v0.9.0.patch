-export type MissionRunReconciliationSummary = {
-  scanned: number;
-  enqueued: number;
-  replaced: number;
-  recovered: number;
-  failed: number;
-  skipped: number;
-  lockAcquired: boolean;
-};
-
-export async function reconcileMissionRuns(options: {
-  queue?: PgMqMissionQueue;
-  now?: Date;
-  stuckAfterSeconds?: number;
-  batchSize?: number;
-} = {}): Promise<MissionRunReconciliationSummary> {
-  const queue = options.queue ?? new PgMqMissionQueue();
-  const now = options.now ?? new Date();
-  const stuckAfterSeconds =
-    options.stuckAfterSeconds ?? getMissionReconciliationStuckSeconds();
-  const batchSize = options.batchSize ?? getMissionReconciliationBatchSize();
-
-  if (
-    !Number.isInteger(stuckAfterSeconds) ||
-    stuckAfterSeconds < 60 ||
-    stuckAfterSeconds > 604_800
-  ) {
-    throw new Error("invalid_reconciliation_stuck_seconds");
-  }
-
-  if (!Number.isInteger(batchSize) || batchSize < 1 || batchSize > 500) {
-    throw new Error("invalid_reconciliation_batch_size");
-  }
-
-  return prisma.$transaction(
-    async (tx) => {
-      const lockRows = await tx.$queryRaw<Array<{ acquired: boolean }>>(
-        Prisma.sql`
-          SELECT pg_try_advisory_xact_lock(
-            hashtextextended('ai-council-runtime:mission-reconciliation', 0)
-          ) AS acquired
-        `
-      );
-
-      if (lockRows[0]?.acquired !== true) {
-        return {
-          scanned: 0,
-          enqueued: 0,
-          replaced: 0,
-          recovered: 0,
-          failed: 0,
-          skipped: 0,
-          lockAcquired: false
-        };
-      }
-
-      const candidates = await tx.missionRun.findMany({
-        where: {
-          status: { in: [QUEUED, RUNNING, RETRYABLE] }
-        },
-        orderBy: { updatedAt: "asc" },
-        take: batchSize
-      });
-      const summary: MissionRunReconciliationSummary = {
-        scanned: candidates.length,
-        enqueued: 0,
-        replaced: 0,
-        recovered: 0,
-        failed: 0,
-        skipped: 0,
-        lockAcquired: true
-      };
-
-      for (const candidate of candidates) {
-        let queueMessageExists: boolean | undefined;
-
-        if (candidate.queueMessageId !== null) {
-          const exists = await queue.exists(
-            candidate.queueMessageId,
-            tx as MissionQueueSqlClient
-          );
-          queueMessageExists = exists === null ? undefined : exists;
-        }
-
-        const action = planMissionRunReconciliation({
-          run: candidate,
-          now,
-          stuckAfterMilliseconds: stuckAfterSeconds * 1_000,
-          queueMessageExists
-        });
-
-        if (action === "none") {
-          summary.skipped += 1;
-          continue;
-        }
-
-        if (action === "fail_attempts_exhausted") {
-          const failed = await tx.missionRun.updateMany({
-            where: {
-              id: candidate.id,
-              status: candidate.status,
-              leaseEpoch: candidate.leaseEpoch,
-              queueGeneration: candidate.queueGeneration
-            },
-            data: {
-              status: FAILED,
-              completedAt: now,
-              leaseOwner: null,
-              leaseExpiresAt: null,
-              nextAttemptAt: null,
-              lastReconciledAt: now,
-              reconcileCount: { increment: 1 },
-              errorCode: "mission_run_attempts_exhausted",
-              errorMessage: "Mission run retry attempts were exhausted."
-            }
-          });
-          summary[failed.count === 1 ? "failed" : "skipped"] += 1;
-          continue;
-        }
-
-        if (action === "recover_expired_lease") {
-          const recovered = await tx.missionRun.updateMany({
-            where: {
-              id: candidate.id,
-              status: RUNNING,
-              leaseEpoch: candidate.leaseEpoch,
-              OR: [
-                { leaseExpiresAt: null },
-                { leaseExpiresAt: { lte: now } }
-              ]
-            },
-            data: {
-              status: RETRYABLE,
-              queueMessageId: null,
-              leaseOwner: null,
-              leaseExpiresAt: null,
-              nextAttemptAt: now,
-              lastReconciledAt: now,
-              reconcileCount: { increment: 1 },
-              errorCode: "expired_lease_recovered",
-              errorMessage: null
-            }
-          });
-
-          if (recovered.count !== 1) {
-            summary.skipped += 1;
-            continue;
-          }
-
-          summary.recovered += 1;
-        } else {
-          const cleared = await tx.missionRun.updateMany({
-            where: {
-              id: candidate.id,
-              status: candidate.status,
-              queueMessageId: candidate.queueMessageId,
-              queueGeneration: candidate.queueGeneration,
-              leaseEpoch: candidate.leaseEpoch
-            },
-            data: {
-              queueMessageId: null,
-              lastReconciledAt: now,
-              reconcileCount: { increment: 1 },
-              errorCode:
-                action === "replace_missing_message"
-                  ? "queue_message_missing"
-                  : action === "replace_stuck_message"
-                    ? "queue_message_stuck"
-                    : null,
-              errorMessage: null
-            }
-          });
-
-          if (cleared.count !== 1) {
-            summary.skipped += 1;
-            continue;
-          }
-
-          if (action !== "enqueue_missing") summary.replaced += 1;
-        }
-
-        const refreshed = await tx.missionRun.findUniqueOrThrow({
-          where: { id: candidate.id }
-        });
-        await enqueueMissionRunInTransaction(tx, refreshed, {
-          queue,
-          delaySeconds: 0,
-          reason: "reconciled",
-          now
-        });
-        summary.enqueued += 1;
-      }
-
-      return summary;
-    },
-    { isolationLevel: Prisma.TransactionIsolationLevel.Serializable }
-  );
-}
