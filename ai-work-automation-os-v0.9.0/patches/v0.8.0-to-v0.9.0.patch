-    return "RED";
-  }
-
-  if (
-    permissions.some(
-      (permission) =>
-        permission === "workspace:write" ||
-        permission === "test:run" ||
-        permission === "team:create" ||
-        permission === "team:staff"
-    )
-  ) {
-    return "YELLOW";
-  }
-
-  return "GREEN";
-}
-
-function highestRisk(a: "GREEN" | "YELLOW" | "RED", b: "GREEN" | "YELLOW" | "RED"): "GREEN" | "YELLOW" | "RED" {
-  const rank = { GREEN: 0, YELLOW: 1, RED: 2 } as const;
-  return rank[a] >= rank[b] ? a : b;
-}
