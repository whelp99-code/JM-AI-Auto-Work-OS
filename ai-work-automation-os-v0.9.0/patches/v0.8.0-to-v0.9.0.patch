-export function evaluateStaffingRequest(input: {
-  request: StaffingRequestV1;
-  manager: OrganizationAgentSnapshot;
-  team: OrganizationTeamSnapshot;
-  existingAgents: readonly OrganizationAgentSnapshot[];
-  managerDirectReportCount?: number;
-  policy: OrganizationPolicySnapshot;
-}): StaffingPolicyDecision {
-  const request = input.request;
-  if (
-    request.schemaVersion !== "staffing-request.v1" ||
-    request.requestKey.length === 0 ||
-    request.missionOrganizationId.length === 0 ||
-    request.requestedByAgentId.length === 0 ||
-    request.missingCapabilities.length === 0 ||
-    !/^(0|[1-9][0-9]*)$/.test(request.expectedCostMicros)
-  ) {
-    throw new Error("staffing_request_invalid");
-  }
-  const reasonCodes: string[] = [];
-
-  if (input.manager.status !== "active") {
-    return rejected(request, ["manager.not_active"]);
-  }
-  if (!input.manager.mayCreateRoles) {
-    return rejected(request, ["manager.role_creation_not_allowed"]);
-  }
-  if ((input.managerDirectReportCount ?? 0) >= input.manager.maxDirectReports) {
-    return rejected(request, ["manager.direct_report_limit_exceeded"], "YELLOW");
-  }
-  if (input.manager.departmentKey !== request.targetDepartmentKey) {
-    return rejected(request, ["manager.department_scope_mismatch"]);
-  }
-  if (
-    input.manager.teamKey !== request.targetTeamKey &&
-    !input.manager.mayCreateTeams
-  ) {
-    return rejected(request, ["manager.team_scope_mismatch"]);
-  }
-  if (input.team.key !== request.targetTeamKey || input.team.departmentKey !== request.targetDepartmentKey) {
-    return rejected(request, ["target.team_mismatch"]);
-  }
-  if (input.team.memberCount >= input.team.maxMembers) {
-    return rejected(request, ["team.member_limit_exceeded"], "YELLOW");
-  }
-
-  const role: OrganizationRoleSpecV1 = request.proposedRole;
-  if (role.reportsToRoleKey !== input.manager.roleKey) {
-    return rejected(request, ["role.reporting_line_mismatch"]);
-  }
-  if (!subset(role.authority, input.manager.authority)) {
-    return rejected(request, ["role.authority_escalation"]);
-  }
-  if (!subset(role.permissions, input.manager.permissions)) {
-    return rejected(request, ["role.permission_escalation"]);
-  }
-  if (role.mayCreateRoles && !input.manager.mayCreateRoles) {
-    return rejected(request, ["role.creation_authority_escalation"]);
-  }
-  if (role.mayCreateTeams && !input.manager.mayCreateTeams) {
-    return rejected(request, ["team.creation_authority_escalation"]);
-  }
-  if (micros(role.budgetAuthorityMicros) > micros(input.manager.budgetAuthorityMicros)) {
-    return rejected(request, ["role.budget_authority_escalation"]);
-  }
-
-  const allowedPermissions = new Set(input.policy.allowedPermissions);
-  const forbiddenPermissions = new Set(input.policy.forbiddenPermissions);
-  const unknownPermissions = role.permissions.filter((permission) => !allowedPermissions.has(permission));
-  const explicitForbidden = role.permissions.filter((permission) => forbiddenPermissions.has(permission));
-  if (unknownPermissions.length > 0 || explicitForbidden.length > 0) {
-    return rejected(request, [
-      ...(unknownPermissions.length > 0 ? ["role.permission_not_allowed"] : []),
-      ...(explicitForbidden.length > 0 ? ["role.permission_forbidden"] : [])
-    ]);
-  }
-
-  if (
-    role.isVerifier &&
-    role.permissions.some((permission) => permission.includes("write") || permission === "team:staff" || permission === "team:create")
-  ) {
-    return rejected(request, ["verifier.independence_violation"]);
-  }
-
-  const expectedCost = micros(request.expectedCostMicros);
-  if (expectedCost > micros(input.team.budgetRemainingMicros)) {
-    return rejected(request, ["team.budget_insufficient"], "YELLOW");
-  }
-  if (expectedCost > micros(input.manager.budgetAuthorityMicros)) {
-    return rejected(request, ["manager.budget_authority_insufficient"], "YELLOW");
-  }
-
-  const reusable = reusableAgent(input.existingAgents, request);
-  if (reusable) {
-    return {
-      status: "reuse_existing",
-      riskLevel: "GREEN",
-      reasonCodes: ["capability.reusable_agent_found"],
-      scopeHash: graphHash({ request, reusableAgentId: reusable.id }),
-      reusableAgentId: reusable.id,
-      effectiveCostMicros: "0"
-    };
-  }
-
-  const capabilitiesCovered = request.missingCapabilities.every((capability) => role.capabilities.includes(capability));
-  if (!capabilitiesCovered) {
-    return rejected(request, ["role.capability_gap_unresolved"], "YELLOW");
-  }
-
-  let riskLevel = permissionRisk(role.permissions);
-  if (role.mayCreateRoles || role.mayCreateTeams) riskLevel = highestRisk(riskLevel, "YELLOW");
