-};
-
-export class GraphCanaryPolicyError extends Error {
-  constructor(readonly code: string) {
-    super(code);
-  }
-}
-
-export function parseGraphCanaryPolicy(input: {
-  version?: string;
-  rolloutMode?: string;
-  allowedOrganizationIds?: string;
-  maxBudgetMicros?: string;
-  requireNoExternalEffects?: string;
-  requireReversible?: string;
-}): GraphCanaryPolicy {
-  const rolloutMode = (input.rolloutMode?.trim() || "disabled") as GraphRolloutMode;
-  if (!graphRolloutModes.includes(rolloutMode)) {
-    throw new GraphCanaryPolicyError("graph_rollout_mode_invalid");
-  }
-  const version = input.version?.trim() || "graph-canary.v1";
-  if (!/^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$/.test(version)) {
-    throw new GraphCanaryPolicyError("graph_canary_version_invalid");
-  }
-  const maxBudgetMicros = input.maxBudgetMicros?.trim() || "5000000";
-  if (!/^\d{1,18}$/.test(maxBudgetMicros)) {
-    throw new GraphCanaryPolicyError("graph_canary_budget_invalid");
-  }
-  const allowedOrganizationIds = (input.allowedOrganizationIds ?? "")
-    .split(",")
-    .map((item) => item.trim())
-    .filter(Boolean);
-  if (
-    allowedOrganizationIds.length > 1_000 ||
-    allowedOrganizationIds.some(
-      (value) => !/^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$/.test(value)
-    )
-  ) {
-    throw new GraphCanaryPolicyError("graph_canary_organization_ids_invalid");
-  }
-  const parseBoolean = (value: string | undefined, fallback: boolean): boolean => {
-    if (value === undefined || value.trim() === "") return fallback;
-    if (value === "true") return true;
-    if (value === "false") return false;
-    throw new GraphCanaryPolicyError("graph_canary_boolean_invalid");
-  };
-  return {
-    schemaVersion: "graph-canary-policy.v1",
-    version,
-    rolloutMode,
-    allowedOrganizationIds: [...new Set(allowedOrganizationIds)],
-    maxBudgetMicros: BigInt(maxBudgetMicros).toString(10),
-    requireNoExternalEffects: parseBoolean(input.requireNoExternalEffects, true),
-    requireReversible: parseBoolean(input.requireReversible, true)
-  };
-}
-
-
-
-export type MissionCanaryWorkItem = {
-  riskLevel: string;
-  actionKind: string;
-};
-
-export type MissionCanaryFacts = {
-  riskLevel: GraphRiskLevel;
-  reversibility: GraphReversibility;
-  externalEffectsRequested: boolean;
-  budgetMicros: string;
-  reasonCodes: string[];
-};
-
-const riskRank: Record<GraphRiskLevel, number> = {
-  GREEN: 0,
-  YELLOW: 1,
-  RED: 2
-};
-
-const reversibilityRank: Record<GraphReversibility, number> = {
-  reversible: 0,
-  partially_reversible: 1,
-  irreversible: 2
-};
-
-const internalCanaryActionKinds = new Set([
-  "research",
-  "architecture_change",
-  "internal_workspace_write"
-]);
-
-function normalizedRisk(value: string): GraphRiskLevel {
-  return value === "GREEN" || value === "YELLOW" || value === "RED"
-    ? value
-    : "RED";
-}
-
-function higherRisk(
-  left: GraphRiskLevel,
-  right: GraphRiskLevel
-): GraphRiskLevel {
-  return riskRank[left] >= riskRank[right] ? left : right;
-}
-
-function lessReversible(
-  left: GraphReversibility,
-  right: GraphReversibility
-): GraphReversibility {
-  return reversibilityRank[left] >= reversibilityRank[right] ? left : right;
-}
-
-function riskReversibility(risk: GraphRiskLevel): GraphReversibility {
-  return risk === "RED"
-    ? "irreversible"
-    : risk === "YELLOW"
-      ? "partially_reversible"
-      : "reversible";
-}
-
-function declaredCanaryFacts(inputJson: string): {
-  reversibility: GraphReversibility | null;
