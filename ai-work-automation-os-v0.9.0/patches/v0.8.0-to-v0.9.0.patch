-  );
-  const externalEffectsRequested =
-    inferredExternalEffects ||
-    declared.parseFailed ||
-    declared.externalEffectsRequested === true;
-  const budgetMicros = String(Math.round(input.budgetUsd * 1_000_000));
-
-  return {
-    riskLevel,
-    reversibility,
-    externalEffectsRequested,
-    budgetMicros,
-    reasonCodes: [
-      `risk:${riskLevel.toLowerCase()}`,
-      `reversibility:${reversibility}`,
-      inferredExternalEffects
-        ? "external_effect_inferred_from_work_item"
-        : "work_items_internal_only",
-      declared.parseFailed
-        ? "mission_input_unparseable_fail_closed"
-        : declared.externalEffectsRequested === true
-          ? "caller_declared_external_effects"
-          : declared.externalEffectsRequested === false
-            ? "caller_declared_no_external_effects"
-            : "external_effects_inferred_from_work_items"
-    ]
-  };
-}
-
-export function decideGraphCanary(input: {
-  policy: GraphCanaryPolicy;
-  requestedMode: RequestedGraphRuntimeMode;
-  organizationId: string;
-  riskLevel: GraphRiskLevel;
-  reversibility: GraphReversibility;
-  budgetMicros: string;
-  externalEffectsRequested: boolean;
-}): GraphCanaryDecision {
-  const reasons: string[] = [`rollout:${input.policy.rolloutMode}`];
-  if (!/^\d{1,30}$/.test(input.budgetMicros)) {
-    throw new GraphCanaryPolicyError("graph_canary_mission_budget_invalid");
-  }
-  if (input.requestedMode === "legacy") {
-    return {
-      requestedMode: "legacy",
-      effectiveMode: "legacy",
-      downgraded: false,
-      eligible: true,
-      reasonCodes: [...reasons, "legacy_requested"],
-      policyVersion: input.policy.version
-    };
-  }
-  if (input.policy.rolloutMode === "disabled") {
-    return {
-      requestedMode: input.requestedMode,
-      effectiveMode: "legacy",
-      downgraded: true,
-      eligible: false,
-      reasonCodes: [...reasons, "graph_runtime_disabled"],
-      policyVersion: input.policy.version
-    };
-  }
-  if (input.requestedMode === "shadow") {
-    return {
-      requestedMode: "shadow",
-      effectiveMode: "shadow",
-      downgraded: false,
-      eligible: true,
-      reasonCodes: [...reasons, "shadow_requested"],
-      policyVersion: input.policy.version
-    };
-  }
-  if (input.policy.rolloutMode === "shadow") {
-    return {
-      requestedMode: "conditional",
-      effectiveMode: "shadow",
-      downgraded: true,
-      eligible: false,
