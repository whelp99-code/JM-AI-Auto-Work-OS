-export type WorkspaceCredentials = {
-  accessToken: string;
-  legacyToken: string;
-};
-
-export class WorkspaceApiError extends Error {
-  readonly status: number;
-  readonly details: unknown;
-
-  constructor(message: string, status: number, details?: unknown) {
-    super(message);
-    this.name = "WorkspaceApiError";
-    this.status = status;
-    this.details = details;
-  }
-}
-
-function record(value: unknown): JsonRecord | null {
-  return value !== null && typeof value === "object" && !Array.isArray(value)
-    ? (value as JsonRecord)
-    : null;
-}
-
-export async function workspaceRequest<T>(
-  url: string,
-  options: RequestInit = {}
-): Promise<T> {
-  if (!isWorkspaceCompanyApiPath(url)) {
-    throw new WorkspaceApiError("workspace_api_path_not_allowed", 400);
-  }
-  const response = await fetch(url, withCompanyBrowserAuth(url, options));
-  let payload: unknown = null;
-  try {
-    payload = await response.json();
-  } catch {
-    throw new WorkspaceApiError(`http_${response.status}`, response.status);
-  }
-  const parsed = record(payload);
-  if (!response.ok) {
-    const message =
-      typeof parsed?.error === "string" ? parsed.error : `http_${response.status}`;
-    throw new WorkspaceApiError(message, response.status, parsed?.details);
-  }
-  return payload as T;
-}
-
-export function readWorkspaceCredentials(): WorkspaceCredentials {
-  if (typeof window === "undefined") {
-    return { accessToken: "", legacyToken: "" };
-  }
-  try {
-    return {
-      accessToken:
-        window.sessionStorage.getItem(COMPANY_ACCESS_TOKEN_STORAGE_KEY) ?? "",
-      legacyToken:
-        window.sessionStorage.getItem(COMPANY_LEGACY_TOKEN_STORAGE_KEY) ?? ""
-    };
-  } catch {
-    return { accessToken: "", legacyToken: "" };
-  }
-}
-
-export function saveWorkspaceCredentials(input: WorkspaceCredentials): void {
-  if (typeof window === "undefined") return;
-  const accessToken = input.accessToken.trim();
-  const legacyToken = input.legacyToken.trim();
-  if (accessToken) {
-    window.sessionStorage.setItem(COMPANY_ACCESS_TOKEN_STORAGE_KEY, accessToken);
-  } else {
-    window.sessionStorage.removeItem(COMPANY_ACCESS_TOKEN_STORAGE_KEY);
-  }
-  if (legacyToken) {
-    window.sessionStorage.setItem(COMPANY_LEGACY_TOKEN_STORAGE_KEY, legacyToken);
-  } else {
-    window.sessionStorage.removeItem(COMPANY_LEGACY_TOKEN_STORAGE_KEY);
-  }
-}
-
-export function newWorkspaceIdempotencyKey(): string {
-  const random =
-    typeof crypto !== "undefined" && typeof crypto.randomUUID === "function"
-      ? crypto.randomUUID().replaceAll("-", "")
-      : Math.random().toString(36).slice(2) + Date.now().toString(36);
-  return `workspace:${Date.now().toString(36)}:${random}`;
-}
