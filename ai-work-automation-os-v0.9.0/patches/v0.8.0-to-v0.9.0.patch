-              : null
-          },
-          stateDelta: {
-            currentPhase: "execution",
-            appendImplementationArtifactRefs: [failedRef],
-            lastSignal: "work_role_failed"
-          },
-          usage: advisory?.usage ?? zeroUsage,
-          artifactRefs: [failedRef],
-          failureDrafts: roleFailures,
-          signals: [{ code: "work_role_failed" }]
-        });
-      }
-
-      const beforeCost = context.mission.estimatedCostUsd;
-      const execution = await context.executeMission();
-      const outcome = missionOutcome(execution.mission);
-      const afterCost =
-        missionEstimatedCostUsd(execution.mission) ?? context.mission.estimatedCostUsd;
-      const estimatedDeltaMicros = Math.max(
-        0,
-        Math.round((afterCost - beforeCost) * 1_000_000)
-      );
-      const missionUsage = execution.usage ?? {
-        calls: 1,
-        inputTokens: 0,
-        outputTokens: 0,
-        costMicros: String(estimatedDeltaMicros)
