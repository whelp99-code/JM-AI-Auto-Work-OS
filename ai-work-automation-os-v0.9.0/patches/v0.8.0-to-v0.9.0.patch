-
-export class GraphWebhookAuthError extends Error {
-  constructor(readonly code: string) {
-    super(code);
-  }
-}
-
-function validatedSecret(secret: string): Buffer {
-  const value = secret.trim();
-  if (value.length < 32 || value.length > 4_096) {
-    throw new GraphWebhookAuthError("graph_role_webhook_secret_invalid");
-  }
-  return Buffer.from(value, "utf8");
-}
-
-function validatedTimestamp(timestamp: string): number {
-  if (!/^\d{1,16}$/.test(timestamp)) {
-    throw new GraphWebhookAuthError("graph_role_webhook_timestamp_invalid");
-  }
-  const value = Number(timestamp);
-  if (!Number.isSafeInteger(value) || value < 0) {
-    throw new GraphWebhookAuthError("graph_role_webhook_timestamp_invalid");
-  }
-  return value;
-}
-
-function validatedReplayWindow(value: number): number {
-  if (!Number.isSafeInteger(value) || value < 30 || value > 3_600) {
-    throw new GraphWebhookAuthError("graph_role_webhook_replay_window_invalid");
-  }
-  return value;
-}
-
-function validatedSignature(signature: string): Buffer {
-  const normalized = signature.trim().toLowerCase();
-  if (!/^[0-9a-f]{64}$/.test(normalized)) {
-    throw new GraphWebhookAuthError("graph_role_webhook_signature_invalid");
-  }
-  return Buffer.from(normalized, "hex");
-}
-
-export function buildGraphWebhookSignature(input: {
-  secret: string;
-  timestamp: string;
-  body: string;
-}): string {
-  const secret = validatedSecret(input.secret);
-  validatedTimestamp(input.timestamp);
-  return createHmac("sha256", secret)
-    .update(input.timestamp, "utf8")
-    .update(".", "utf8")
-    .update(input.body, "utf8")
-    .digest("hex");
-}
-
-export function verifyGraphWebhookResponse(input: {
-  secret: string;
-  timestamp: string;
-  signature: string;
-  body: string;
-  nowSeconds?: number;
-  replayWindowSeconds?: number;
-}): void {
-  const timestamp = validatedTimestamp(input.timestamp);
-  const now = input.nowSeconds ?? Math.floor(Date.now() / 1_000);
-  if (!Number.isSafeInteger(now) || now < 0) {
-    throw new GraphWebhookAuthError("graph_role_webhook_clock_invalid");
-  }
-  const replayWindowSeconds = validatedReplayWindow(
-    input.replayWindowSeconds ?? 300
-  );
-  if (Math.abs(now - timestamp) > replayWindowSeconds) {
-    throw new GraphWebhookAuthError("graph_role_webhook_timestamp_expired");
-  }
