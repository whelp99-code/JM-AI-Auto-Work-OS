-
-    if text.count(AUTH_IMPORT) != 1 or text.count(FETCH_AFTER) != 1:
-        raise RuntimeError(f"UI integration is ambiguous: {path}")
-
-    if changed:
-        path.write_text(text, encoding="utf-8")
-
-    return changed
