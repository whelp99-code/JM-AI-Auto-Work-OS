-async function executeFanOut(input: {
-  graphRun: GraphRun;
-  state: GraphStateV1;
-  parentNode: GraphNodeSpec;
-  parentPrepared: PreparedNodeRun;
-  mission: GraphMissionSnapshot;
-  fence: GraphRunFence;
-  executeMission: () => Promise<GraphMissionExecution>;
-}): Promise<{ parentResult: GraphNodeResult; branchResults: GraphBranchResult[] }> {
-  const targetKey = input.parentNode.fanOutTargetNodeKey;
-  if (!targetKey) throw new GraphRuntimeError("graph_fan_out_target_missing", 500);
-  const childNode = runtimeGraphForSpecHash(input.graphRun.specHash).compiled.nodes.get(
-    targetKey
-  );
-  if (!childNode?.childOnly) {
-    throw new GraphRuntimeError("graph_fan_out_target_invalid", 500);
-  }
-
-  const parentResult = await executeGraphNodeHandler({
-    graphRunId: input.graphRun.id,
-    node: input.parentNode,
-    nodeRunId: input.parentPrepared.nodeRun.id,
-    instanceKey: "root",
-    state: input.state,
-    mission: input.mission,
-    policyVersion: input.graphRun.policyVersion,
-    specHash: input.graphRun.specHash,
-    stateVersion: input.graphRun.stateVersion,
-    unresolvedExternalEffects: 0,
-    executeMission: input.executeMission
-  });
-  const branchInputs = buildResearchBranchInputs(input.state).slice(
-    0,
-    input.graphRun.maxFanOut
-  );
-  const preparedChildren: Array<{
-    prepared: PreparedNodeRun;
-    branchInput: unknown;
-  }> = [];
-
-  for (const [index, branchInput] of branchInputs.entries()) {
-    const prepared = await prepareNodeRun({
-      graphRun: await currentGraphRun(input.graphRun.id),
-      node: childNode,
-      state: input.state,
-      fence: input.fence,
-      instanceKey: `${input.parentNode.key}.${input.graphRun.stateVersion}.${String(
-        index + 1
-      ).padStart(3, "0")}`,
-      branchInput
-    });
-    preparedChildren.push({ prepared, branchInput });
-  }
-
-  type BranchExecution =
-    | {
-        status: "fulfilled";
-        prepared: PreparedNodeRun;
-        result: GraphNodeResult;
-      }
-    | {
-        status: "rejected";
-        prepared: PreparedNodeRun;
-        error: unknown;
-      };
-
-  const executed = await limitedParallelMap<
-    (typeof preparedChildren)[number],
-    BranchExecution
-  >(
-    preparedChildren,
-    Math.min(input.state.route.maxParallel, input.graphRun.maxParallel),
-    async ({ prepared, branchInput }) => {
-      try {
-        const executeRole = roleExecutorForPreparedNode({
-          graphRun: input.graphRun,
-          node: childNode,
-          nodeRun: prepared.nodeRun,
-          instanceKey: prepared.nodeRun.instanceKey,
-          state: input.state,
-          roleReservation: prepared.roleReservation
-        });
-        return {
-          status: "fulfilled",
-          prepared,
-          result: await executeGraphNodeHandler({
-            graphRunId: input.graphRun.id,
-            node: childNode,
-            nodeRunId: prepared.nodeRun.id,
-            instanceKey: prepared.nodeRun.instanceKey,
-            state: input.state,
-            mission: input.mission,
-            policyVersion: input.graphRun.policyVersion,
-            specHash: input.graphRun.specHash,
-            stateVersion: input.graphRun.stateVersion,
-            branchInput,
-            ...(executeRole ? { executeRole } : {}),
-            unresolvedExternalEffects: 0,
-            executeMission: input.executeMission
-          })
-        };
-      } catch (error) {
-        return { status: "rejected", prepared, error };
-      }
-    }
-  );
-  const branchResults: GraphBranchResult[] = [];
-  let firstBranchError: unknown;
-  let hasBranchError = false;
-
-  // Settle every successful branch before surfacing a sibling failure. This
-  // preserves its usage, cost, evidence, and immutable result, preventing a
-  // partially successful fan-out from silently escaping budget accounting.
-  for (const item of executed.sort((a, b) =>
-    a.prepared.nodeRun.instanceKey.localeCompare(b.prepared.nodeRun.instanceKey)
