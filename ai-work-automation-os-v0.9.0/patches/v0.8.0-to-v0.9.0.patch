-function setRoleBudget(
-  role: OrganizationRoleSpecV1,
-  budget: bigint,
-  parentBudget: bigint
-): void {
-  const bounded = budget > parentBudget ? parentBudget : budget;
-  role.budgetAuthorityMicros = (bounded < 0n ? 0n : bounded).toString(10);
-}
-
-function scaleTeam(team: OrganizationTeamSpecV1, target: bigint, departmentBudget: bigint): void {
-  team.budgetLimitMicros = target.toString(10);
-  const leadRoles = team.roles.filter((role) => role.isLead);
-  const memberRoles = team.roles.filter((role) => !role.isLead);
-
-  for (const lead of leadRoles) {
-    setRoleBudget(lead, target, departmentBudget);
-  }
-
-  const memberBudget = memberRoles.length > 0 ? target / BigInt(memberRoles.length + 1) : 0n;
-  for (const member of memberRoles) {
-    setRoleBudget(member, memberBudget, target);
-  }
-}
-
-function scaleDepartment(
-  department: OrganizationDepartmentSpecV1,
-  target: bigint,
-  globalBudget: bigint
-): void {
-  department.budgetLimitMicros = target.toString(10);
-  setRoleBudget(department.leaderRole, target, globalBudget);
-
-  const nominal = department.teams.map((team) => BigInt(team.budgetLimitMicros));
-  const nominalTotal = nominal.reduce((sum, value) => sum + value, 0n);
-  let allocated = 0n;
-
-  department.teams.forEach((team, index) => {
-    const last = index === department.teams.length - 1;
-    const share = last
-      ? target - allocated
-      : nominalTotal > 0n
-        ? (target * nominal[index]) / nominalTotal
-        : target / BigInt(department.teams.length);
-    allocated += share;
-    scaleTeam(team, share, target);
-  });
-}
-
-function scalePlanBudget(
-  departments: OrganizationDepartmentSpecV1[],
-  executive: OrganizationRoleSpecV1,
-  target: bigint
-): void {
-  const nominal = departments.map((department) => BigInt(department.budgetLimitMicros));
-  const nominalTotal = nominal.reduce((sum, value) => sum + value, 0n);
-  let allocated = 0n;
-
-  departments.forEach((department, index) => {
-    const last = index === departments.length - 1;
-    const share = last
-      ? target - allocated
-      : nominalTotal > 0n
-        ? (target * nominal[index]) / nominalTotal
-        : target / BigInt(departments.length);
-    allocated += share;
-    scaleDepartment(department, share, target);
-  });
-
-  executive.budgetAuthorityMicros = target.toString(10);
-}
