-
-const forbiddenExternalEffectArgumentKeys = new Set([
-  "apikey",
-  "accesstoken",
-  "refreshtoken",
-  "authtoken",
-  "authorization",
-  "proxyauthorization",
-  "password",
-  "passwd",
-  "secret",
-  "clientsecret",
-  "servicerolekey",
-  "privatekey",
-  "cookie",
-  "setcookie",
-  "databaseurl",
-  "connectionstring",
-  "awssecretaccesskey"
-]);
-
-function normalizedArgumentKey(value: string): string {
-  return value.toLowerCase().replace(/[^a-z0-9]/g, "");
-}
-
-function canonicalize(value: unknown, seen: Set<object>): unknown {
-  if (
-    value === null ||
-    typeof value === "string" ||
-    typeof value === "boolean"
-  ) {
-    return value;
-  }
-
-  if (typeof value === "number") {
-    if (!Number.isFinite(value)) {
-      throw new Error("external_effect_arguments_not_json");
-    }
-
-    return Object.is(value, -0) ? 0 : value;
-  }
-
-  if (typeof value === "bigint") {
-    throw new Error("external_effect_arguments_not_json");
-  }
-
-  if (typeof value !== "object") {
-    throw new Error("external_effect_arguments_not_json");
-  }
-
-  if (seen.has(value)) {
-    throw new Error("external_effect_arguments_cyclic");
-  }
-
-  seen.add(value);
-
-  try {
-    if (Array.isArray(value)) {
-      return value.map((item) => canonicalize(item, seen));
-    }
-
-    const prototype = Object.getPrototypeOf(value);
-
-    if (prototype !== Object.prototype && prototype !== null) {
-      throw new Error("external_effect_arguments_not_plain_object");
-    }
-
-    const output: Record<string, unknown> = Object.create(null) as Record<
-      string,
-      unknown
-    >;
-
-    for (const key of Object.keys(value).sort()) {
-      if (
-        key === "__proto__" ||
-        key === "prototype" ||
-        key === "constructor" ||
-        forbiddenExternalEffectArgumentKeys.has(normalizedArgumentKey(key))
-      ) {
-        throw new Error("external_effect_arguments_forbidden_key");
-      }
-
-      const item = (value as Record<string, unknown>)[key];
-
-      if (item === undefined) {
-        throw new Error("external_effect_arguments_not_json");
-      }
-
-      output[key] = canonicalize(item, seen);
-    }
-
-    return output;
-  } finally {
-    seen.delete(value);
-  }
-}
-
-export function canonicalJson(value: unknown, maximumBytes = 262_144): string {
-  if (!Number.isInteger(maximumBytes) || maximumBytes < 1) {
-    throw new Error("invalid_external_effect_maximum_bytes");
-  }
-
-  const serialized = JSON.stringify(canonicalize(value, new Set()));
-
-  if (Buffer.byteLength(serialized, "utf8") > maximumBytes) {
-    throw new Error("external_effect_payload_too_large");
-  }
-
-  return serialized;
-}
-
-function validatedToken(name: string, value: string, maximum: number): string {
-  const token = value.trim();
-
-  if (
-    token.length < 1 ||
-    token.length > maximum ||
-    !/^[A-Za-z0-9._:@/-]+$/.test(token)
-  ) {
-    throw new Error(`invalid_external_effect_${name}`);
-  }
-
-  return token;
-}
-
-export function buildExternalEffectIdentity(
-  input: ExternalEffectIdentityInput
-): ExternalEffectIdentity {
-  const operation = validatedToken("operation", input.operation, 120);
-  const actionKind = validatedToken("action_kind", input.actionKind, 120);
-  const provider =
-    input.provider === undefined
-      ? null
-      : validatedToken("provider", input.provider, 120);
-  const graphScopeKey =
-    input.graphScopeKey === undefined
-      ? null
-      : validatedToken("graph_scope_key", input.graphScopeKey, 512);
-  const identityVersion = graphScopeKey === null ? 2 : 3;
-
-  if (!Number.isInteger(input.runAttempt) || input.runAttempt < 1) {
-    throw new Error("invalid_external_effect_run_attempt");
-  }
-
-  const argumentsJson = canonicalJson(input.arguments);
-  const requestHash = createHash("sha256")
-    .update(
-      JSON.stringify({
-        version: identityVersion,
-        missionId: input.missionId,
-        workItemId: input.workItemId,
-        operation,
-        actionKind,
-        replayPolicy: input.replayPolicy,
-        provider,
-        graphScopeKey,
-        arguments: JSON.parse(argumentsJson) as unknown
-      }),
-      "utf8"
-    )
-    .digest("hex");
-  const effectKey = createHash("sha256")
-    .update(
-      JSON.stringify({
-        version: identityVersion,
-        runId: input.runId,
-        workItemId: input.workItemId,
-        missionId: input.missionId,
-        operation,
-        actionKind,
-        graphScopeKey
-      }),
-      "utf8"
-    )
-    .digest("hex");
-
-  return { effectKey, requestHash, argumentsJson };
-}
-
-export type ExistingExternalEffectDecision =
-  | "create"
-  | "replay"
-  | "retry"
-  | "busy"
-  | "manual_reconciliation_required"
-  | "terminal_failure"
-  | "request_mismatch";
-
-export function decideExistingExternalEffect(input: {
-  exists: boolean;
-  status?: string;
-  storedRequestHash?: string;
-  requestHash: string;
-  storedLeaseEpoch?: number;
-  currentLeaseEpoch: number;
-  replayPolicy: ExternalEffectReplayPolicy;
-}): ExistingExternalEffectDecision {
-  if (!input.exists) return "create";
-  if (input.storedRequestHash !== input.requestHash) return "request_mismatch";
-  if (input.status === "succeeded") return "replay";
-
-  const sameFence = input.storedLeaseEpoch === input.currentLeaseEpoch;
-
-  if (
-    sameFence &&
-    (input.status === "prepared" || input.status === "executing")
-  ) {
-    return "busy";
-  }
-
-  if (input.replayPolicy === "manual_reconcile") {
-    if (input.status === "retry_authorized") return "retry";
-    if (input.status === "failed") return "terminal_failure";
-
-    if (input.status === "executing" || input.status === "unknown") {
-      return "manual_reconciliation_required";
-    }
-  }
-
-  return "retry";
-}
-
-export function serializeExternalEffectResult(value: unknown): string {
