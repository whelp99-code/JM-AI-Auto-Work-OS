-function pinnedGraphMode(
-  graphRun: Pick<GraphRun, "mode">
-): "shadow" | "conditional" {
-  if (graphRun.mode !== "shadow" && graphRun.mode !== "conditional") {
-    throw new GraphRuntimeError("graph_runtime_mode_invalid", 409);
-  }
-  return graphRun.mode;
-}
-
-function assertPinnedGraphRun(input: {
-  graphRun: Pick<GraphRun, "mode" | "specHash" | "policyVersion">;
-  expectedMode: "shadow" | "conditional";
-}): void {
-  const mode = pinnedGraphMode(input.graphRun);
-
-  try {
-    const runtimeGraph = runtimeGraphForSpecHash(input.graphRun.specHash);
-    assertGraphRuntimePin({
-      mode,
-      expectedMode: input.expectedMode,
-      specHash: input.graphRun.specHash,
-      expectedSpecHash: runtimeGraph.compiled.specHash,
-      policyVersion: input.graphRun.policyVersion,
-      expectedPolicyVersion: runtimeGraph.policyVersion
-    });
-  } catch (error) {
-    throw new GraphRuntimeError(
-      error instanceof Error ? error.message : "graph_runtime_pin_mismatch",
-      409
-    );
-  }
-}
