-} from "@/lib/graph/types";
-
-export const graphRolloutModes = [
-  "disabled",
-  "shadow",
-  "green_canary",
-  "unrestricted"
-] as const;
-
-export type GraphRolloutMode = (typeof graphRolloutModes)[number];
-export type RequestedGraphRuntimeMode = "legacy" | "shadow" | "conditional";
-
-export type GraphCanaryPolicy = {
-  schemaVersion: "graph-canary-policy.v1";
-  version: string;
-  rolloutMode: GraphRolloutMode;
-  allowedOrganizationIds: string[];
-  maxBudgetMicros: string;
-  requireNoExternalEffects: boolean;
-  requireReversible: boolean;
-};
-
-export type GraphCanaryDecision = {
-  requestedMode: RequestedGraphRuntimeMode;
