-        signals: [{ code: signal }]
-      });
-    }
-
-    case "direct_execute":
-    case "execute":
-    case "develop": { // develop is a legacy software-development-only node alias.
-      const advisory =
-        context.node.handlerId === "execute"
-          ? await executeOptionalRole(context, {
-              role: "specialist",
-              purpose: "business_work_proposal",
-              projectedState,
-              maxOutputTokens: 8_000
-            })
-          : context.node.handlerId === "develop"
-            ? await executeOptionalRole(context, {
-                role: "developer",
-                purpose: "legacy_development_proposal",
-                projectedState,
-                maxOutputTokens: 8_000
-              })
-            : null;
-      const roleFailures = controllingRoleFailures(advisory);
-      if (roleFailures.some((failure) => failure.blocking)) {
-        const failedRef = artifactRef(context.nodeRunId, "work_role_failure");
-        return nodeResult({
-          output: {
-            projectedState,
-            outcome: context.state.missionOutcome,
-            executionMode: context.node.handlerId,
-            workProposal: advisory?.output ?? null,
-            missionExecutionSkipped: true,
-            roleInvocation: advisory
-              ? {
-                  runtimeMode: advisory.runtimeMode ?? "live",
-                  status: advisory.status,
-                  provider: advisory.provider,
-                  model: advisory.model,
-                  modelClass: advisory.modelClass,
-                  invocationId: advisory.invocationId,
-                  routeReasonCodes: advisory.routeReasonCodes
