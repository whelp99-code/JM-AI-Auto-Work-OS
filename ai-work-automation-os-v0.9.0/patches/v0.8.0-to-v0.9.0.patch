-function createInitialGraphState(mission: Mission): GraphStateV1 {
-  const snapshot = missionSnapshot(mission);
-  const missionRisk = riskLevel(snapshot.riskLevel);
-  const inputReversibility = snapshot.input.reversibility;
-  const reversibility =
-    inputReversibility === "irreversible" ||
-    inputReversibility === "partially_reversible" ||
-    inputReversibility === "reversible"
-      ? inputReversibility
-      : missionRisk === "RED"
-        ? "irreversible"
-        : missionRisk === "YELLOW"
-          ? "partially_reversible"
-          : "reversible";
-  const costLimitMicros = Math.max(
-    0,
-    Math.round(
-      Math.max(0, snapshot.budgetUsd - snapshot.estimatedCostUsd) * 1_000_000
-    )
-  ).toString(10);
-
-  return graphStateSchema.parse({
-    schemaVersion: "graph-state.v1",
-    objective: snapshot.objective,
-    requirements: snapshot.successCriteria,
-    constraints: snapshot.constraints,
-    classification: {
-      complexity: "low",
-      uncertainty: 0,
-      riskLevel: missionRisk,
-      reversibility
-    },
-    route: {
-      class: "complex",
-      researchFanOut: compiledDefaultGraph.spec.limits.maxFanOut,
-      maxParallel: compiledDefaultGraph.spec.limits.maxParallel,
-      modelClass: "balanced",
-      verificationProfile: "standard",
-      reasonCodes: ["not_triaged"]
-    },
-    currentPhase: "start",
-    currentNodeKey: compiledDefaultGraph.spec.startNode,
-    iteration: {
-      total: 0,
-      byNode: {},
-      max: compiledDefaultGraph.spec.limits.maxIterations,
-      sameFailureLimit: compiledDefaultGraph.spec.limits.sameFailureLimit
-    },
-    researchFindingRefs: [],
-    planArtifactRef: null,
-    implementationArtifactRefs: [],
-    verificationResultRefs: [],
-    synthesisArtifactRef: null,
-    verification: {
-      status: "not_run",
-      profile: "standard",
-      verifiedAtStateVersion: null,
-      targetHash: null
-    },
-    openFailures: [],
-    budget: {
-      callsLimit: integerEnvironment("GRAPH_CALLS_LIMIT", 24, 1, 1_000_000),
-      callsUsed: 0,
-      callsReserved: 0,
-      tokensLimit: integerEnvironment(
-        "GRAPH_TOKENS_LIMIT",
-        100_000,
-        1,
-        2_147_483_647
-      ),
-      tokensUsed: 0,
-      tokensReserved: 0,
-      costLimitMicros,
-      costUsedMicros: "0",
-      costReservedMicros: "0",
-      deadlineAt: snapshot.deadline?.toISOString() ?? null
-    },
-    approval: {
-      required: false,
-      decisionId: null,
-      status: null,
-      scopeHash: null
-    },
-    missionOutcome: {
-      missionStatus: null,
-      summary: null,
-      evidenceMode: "unknown"
-    },
-    lastSignal: "initialized",
-    finalStatus: "running"
-  });
