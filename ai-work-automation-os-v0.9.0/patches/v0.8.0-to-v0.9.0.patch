-      throw new GraphRoleContractError("research_source_invalid");
-    }
-    strictKeys(
-      item,
-      ["url", "title", "sourceType", "supports", "publishedAt"],
-      "research_source_unknown_field"
-    );
-    const rawUrl = stringValue(item.url, "research_source_url_invalid", 2_048);
-    let parsed: URL;
-    try {
-      parsed = new URL(rawUrl);
