-create or replace function app_private.mission_queue_set_vt(
-  p_message_id bigint,
-  p_visibility_seconds integer
-) returns boolean
-language plpgsql
-security definer
-set search_path = pg_catalog, pgmq
-as $$
-declare
-  v_updated boolean;
-begin
-  if p_visibility_seconds < 1 or p_visibility_seconds > 86400 then
-    raise exception 'invalid visibility timeout' using errcode = '22023';
-  end if;
-
-  select exists (
-    select 1
-    from pgmq.set_vt('mission_runs', p_message_id, p_visibility_seconds)
-  ) into v_updated;
-  return v_updated;
-end
-$$;
-
-create or replace function app_private.mission_queue_exists(
-  p_message_id bigint
-) returns boolean
-language sql
-security definer
-set search_path = pg_catalog, pgmq
-stable
-as $$
-  select exists (
-    select 1
-    from pgmq.q_mission_runs
