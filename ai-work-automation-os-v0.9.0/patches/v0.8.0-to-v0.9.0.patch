-function nodeResult(input: {
-  output?: unknown;
-  stateDelta?: GraphNodeResult["stateDelta"];
-  usage?: GraphUsage;
-  artifactRefs?: string[];
-  failureDrafts?: FailurePacketDraft[];
-  signals?: GraphNodeResult["signals"];
-}): GraphNodeResult {
-  return {
-    output: input.output ?? {},
-    stateDelta: input.stateDelta ?? {},
-    usage: input.usage ?? zeroUsage,
