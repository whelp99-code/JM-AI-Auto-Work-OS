-} {
-  try {
-    const value = JSON.parse(inputJson) as {
-      reversibility?: unknown;
-      graphCanary?: {
-        reversibility?: unknown;
-        externalEffectsRequested?: unknown;
-      };
-    };
-    const candidate = value?.graphCanary;
-    const declaredReversibility =
-      candidate?.reversibility ?? value?.reversibility;
-    const reversibility =
-      declaredReversibility === "reversible" ||
-      declaredReversibility === "partially_reversible" ||
-      declaredReversibility === "irreversible"
-        ? declaredReversibility
-        : null;
-    return {
-      reversibility,
-      externalEffectsRequested:
-        typeof candidate?.externalEffectsRequested === "boolean"
-          ? candidate.externalEffectsRequested
-          : null,
-      parseFailed: false
-    };
-  } catch {
-    return {
-      reversibility: null,
-      externalEffectsRequested: null,
-      parseFailed: true
-    };
-  }
-}
