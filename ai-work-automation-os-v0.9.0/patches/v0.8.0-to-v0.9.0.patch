-  ) {
-    throw new GraphRoleContractError("verifier_failure_route_invalid");
-  }
-  return {
-    failureType: value.failureType as FailurePacketDraft["failureType"],
-    severity: value.severity as FailurePacketDraft["severity"],
-    blocking: value.blocking,
-    checkId: stringValue(value.checkId, "verifier_failure_check_id_invalid", 256),
-    evidenceRefs: validateEvidenceRefs(value.evidenceRefs),
-    expected: stringValue(value.expected, "verifier_failure_expected_invalid"),
-    observed: stringValue(value.observed, "verifier_failure_observed_invalid"),
-    ...(value.recommendedRoute === undefined
