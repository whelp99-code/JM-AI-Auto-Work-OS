-    return {
-      id: stringValue(item.id, "planner_risk_id_invalid", 128),
-      description: stringValue(item.description, "planner_risk_description_invalid"),
-      mitigation: stringValue(item.mitigation, "planner_risk_mitigation_invalid")
-    };
-  });
-  return {
-    kind: "plan",
-    summary: stringValue(value.summary, "planner_summary_invalid"),
-    steps,
-    risks,
-    assumptions: stringArray(value.assumptions, "planner_assumptions_invalid", 100)
-  };
