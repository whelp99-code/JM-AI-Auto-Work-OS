-export function collectWorkspaceEvidence(input: {
-  mission: unknown;
-  graph: unknown;
-}): WorkspaceEvidenceItem[] {
-  const mission = asRecord(input.mission);
-  const graph = asRecord(input.graph);
-  const evidence: WorkspaceEvidenceItem[] = [];
-
-  const evaluations = [
-    ...asRecords(mission?.evaluations),
-    ...asRecords(mission?.workItems).flatMap((item) => asRecords(item.evaluations))
-  ];
-
-  for (const evaluation of evaluations) {
-    const id = stringValue(
-      evaluation.id,
-      stableId("evaluation", evaluation.evaluator, evaluation.createdAt)
-    );
-    evidence.push({
-      id,
-      source: "evaluation",
-      title: stringValue(evaluation.evaluator, "Independent evaluation"),
-      status: stringValue(evaluation.status, "unknown"),
-      score:
-        typeof evaluation.score === "number" && Number.isFinite(evaluation.score)
-          ? evaluation.score
-          : null,
-      evidenceRefs: Array.isArray(evaluation.evidence) ? evaluation.evidence : [],
-      findings: asStrings(evaluation.findings),
-      createdAt: dateString(evaluation.createdAt),
-      metadata: {
-        criteria: evaluation.criteria,
-        verificationProfile: evaluation.verificationProfile
-      }
-    });
-  }
-
-  for (const failure of asRecords(graph?.failures)) {
-    evidence.push({
-      id: stringValue(failure.id, stableId("failure", failure.fingerprint)),
-      source: "graph_failure",
-      title: `${stringValue(failure.failureType, "failure")} · ${stringValue(
-        failure.checkId,
-        "unknown_check"
-      )}`,
-      status: stringValue(failure.status, "open"),
-      score: null,
-      evidenceRefs: Array.isArray(failure.evidenceRefs) ? failure.evidenceRefs : [],
-      findings: [stringValue(failure.observed), stringValue(failure.expected)]
-        .filter(Boolean)
-        .map((item, index) => (index === 0 ? `관측: ${item}` : `기대: ${item}`)),
-      createdAt: dateString(failure.createdAt),
-      metadata: {
-        severity: failure.severity,
-        blocking: failure.blocking,
-        recommendedRoute: failure.recommendedRoute,
-        fingerprint: failure.fingerprint
-      }
-    });
-  }
-
-  for (const invocation of asRecords(graph?.roleInvocations)) {
-    if (!invocation.outputHash && !invocation.providerRequestId) continue;
-    evidence.push({
-      id: stringValue(invocation.id, stableId("invocation", invocation.role, invocation.createdAt)),
-      source: "role_invocation",
-      title: `${stringValue(invocation.role, "role")} · ${stringValue(
-        invocation.model,
-        "model"
-      )}`,
-      status: stringValue(invocation.status, "unknown"),
-      score: null,
-      evidenceRefs: [invocation.outputHash, invocation.providerRequestId].filter(Boolean),
-      findings: [],
-      createdAt: dateString(invocation.completedAt) ?? dateString(invocation.createdAt),
-      metadata: {
-        provider: invocation.provider,
-        modelClass: invocation.modelClass,
-        mode: invocation.mode,
-        usage: invocation.usage
-      }
-    });
-  }
-
-  const seen = new Set<string>();
-  return evidence.filter((item) => {
-    if (seen.has(item.id)) return false;
-    seen.add(item.id);
-    return true;
-  });
-}
