-function validateFailure(value: unknown): FailurePacketDraft {
-  if (!isPlainObject(value)) {
-    throw new GraphRoleContractError("verifier_failure_invalid");
-  }
-  strictKeys(
-    value,
-    [
-      "failureType",
-      "severity",
-      "blocking",
-      "checkId",
-      "evidenceRefs",
-      "expected",
-      "observed",
-      "recommendedRoute",
-      "retryable"
-    ],
-    "verifier_failure_unknown_field"
-  );
-  const failureTypes = [
-    "execution_error",
-    "implementation_error",
-    "design_error",
-    "requirements_ambiguity",
-    "evidence_gap",
-    "test_defect",
-    "security_risk",
-    "permission_risk",
-    "tool_failure",
-    "model_failure",
-    "budget_exceeded",
-    "unknown"
-  ] as const;
-  const severities = ["low", "medium", "high", "critical"] as const;
-  const routes = [
-    "research",
-    "plan",
-    "execute",
-    "develop",
-    "verify",
-    "human",
-    "partial",
-    "failed"
-  ] as const;
-  if (
-    typeof value.failureType !== "string" ||
-    !failureTypes.includes(value.failureType as (typeof failureTypes)[number]) ||
-    typeof value.severity !== "string" ||
