-      request,
-      managerId: input.manager.id,
-      teamId: input.team.id,
-      policyVersion: input.policy.policyVersion,
-      status,
-      riskLevel
-    }),
-    reusableAgentId: null,
-    effectiveCostMicros: request.expectedCostMicros
-  };
-}
