-}): Promise<{ id: string; status: string; retiredAgentCount: number } | null> {
-  return prisma.$transaction(async (tx) => {
-    const organization = await tx.missionOrganization.findUnique({
-      where: { missionRunId: input.missionRunId },
-      select: { id: true, status: true }
-    });
-    if (!organization) return null;
-    if (organization.status === "retired") {
-      return { id: organization.id, status: organization.status, retiredAgentCount: 0 };
-    }
-
-    const terminalAssignmentStatus =
-      input.outcome === "completed" ? "completed" : "cancelled";
-    await tx.organizationAssignment.updateMany({
-      where: {
-        missionOrganizationId: organization.id,
-        status: { in: ["planned", "running"] }
-      },
-      data: { status: terminalAssignmentStatus }
-    });
-    const temporaryAgents = await tx.agentInstance.findMany({
-      where: {
-        missionOrganizationId: organization.id,
-        temporary: true,
-        status: { not: "retired" }
-      },
-      select: { id: true }
-    });
-    if (temporaryAgents.length > 0) {
-      await tx.agentInstance.updateMany({
-        where: { id: { in: temporaryAgents.map((agent) => agent.id) } },
-        data: { status: "retired", retiredAt: new Date() }
