-    branchResults.push(
-      await persistChildResult({
-        graphRun: await currentGraphRun(input.graphRun.id),
-        node: childNode,
-        nodeRun: item.prepared.nodeRun,
-        result: item.result,
-        reservation: item.prepared.reservation,
-        roleReservation: item.prepared.roleReservation,
-        fence: input.fence
-      })
-    );
-  }
-
-  if (hasBranchError) throw firstBranchError;
-
-  const ordered = deterministicBranchOrder(
-    branchResults,
-    input.graphRun.maxFanOut
-  );
-  return {
-    parentResult: {
-      ...parentResult,
-      output: {
-        ...(parentResult.output as Record<string, unknown>),
-        branchResults: ordered.map((result) => ({
-          instanceKey: result.instanceKey,
-          output: result.output,
-          artifactRefs: result.artifactRefs
-        }))
-      },
-      failureDrafts: [
-        ...parentResult.failureDrafts,
-        ...ordered.flatMap((result) => result.failureDrafts)
-      ]
-    },
-    branchResults: ordered
-  };
-}
