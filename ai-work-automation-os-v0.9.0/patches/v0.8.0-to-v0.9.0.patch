-import type {
-  WorkspaceAccessRole,
-  WorkspaceApproval,
-  WorkspaceApprovalKind
-} from "@/lib/workspace/types";
-
-const resourceSegment = "[A-Za-z0-9._~+-]+";
-
-const endpointPatterns: Record<WorkspaceApprovalKind, RegExp> = {
-  executive: new RegExp(`^/api/company/decisions/${resourceSegment}$`),
-  graph: new RegExp(`^/api/company/(?:workflow|graph)-decisions/${resourceSegment}$`),
-  staffing: new RegExp(
-    `^/api/company/staffing-requests/${resourceSegment}/resolve$`
-  ),
-  team_formation: new RegExp(
-    `^/api/company/team-formation-requests/${resourceSegment}/resolve$`
-  ),
-  external_effect: new RegExp(
-    `^/api/company/effects/${resourceSegment}/reconcile$`
-  )
-};
-
-const approvalKindsRequiringScopeHash = new Set<WorkspaceApprovalKind>([
-  "graph",
-  "staffing",
-  "team_formation"
-]);
-
-export function isWorkspaceCompanyApiPath(url: string): boolean {
-  if (
-    !url.startsWith("/api/company/") ||
-    url.startsWith("//") ||
-    url.includes("\\") ||
-    /[\u0000-\u001F\u007F]/.test(url)
-  ) {
-    return false;
-  }
-
-  const rawPath = url.split(/[?#]/, 1)[0] ?? "";
-  if (/%(?:2f|5c)/i.test(rawPath)) {
-    return false;
-  }
-  let decodedPath: string;
-  try {
-    decodedPath = decodeURIComponent(rawPath);
-  } catch {
-    return false;
-  }
-  if (decodedPath.includes("\\") || /[\u0000-\u001F\u007F]/.test(decodedPath)) {
-    return false;
-  }
-  const segments = decodedPath.split("/");
-  return !segments.some((segment) => segment === "." || segment === "..");
-}
-
-export function isAllowedWorkspaceApprovalEndpoint(
-  kind: WorkspaceApprovalKind,
-  endpoint: string
-): boolean {
-  return (
-    isWorkspaceCompanyApiPath(endpoint) && endpointPatterns[kind].test(endpoint)
-  );
-}
-
-export function canResolveWorkspaceApproval(
-  role: WorkspaceAccessRole,
-  approval: WorkspaceApproval
-): boolean {
-  return (
-    role === "ceo" &&
-    approval.actionable === true &&
-    approval.allowedResolutions.length > 0 &&
-    (!approvalKindsRequiringScopeHash.has(approval.kind) ||
-      Boolean(approval.scopeHash)) &&
-    isAllowedWorkspaceApprovalEndpoint(approval.kind, approval.endpoint)
-  );
-}
