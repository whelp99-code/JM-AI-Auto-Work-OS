-  return (
-    agents.find(
-      (agent) =>
-        agent.status === "active" &&
-        agent.teamKey === request.targetTeamKey &&
-        [...needed].every((capability) => agent.capabilities.includes(capability))
-    ) ??
-    agents.find(
-      (agent) =>
-        (agent.status === "active" || agent.status === "idle") &&
-        [...needed].every((capability) => agent.capabilities.includes(capability))
-    ) ??
-    null
-  );
-}
