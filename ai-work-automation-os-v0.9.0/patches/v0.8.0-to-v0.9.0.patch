+
+  @@unique([organizationId, slug])
+  @@index([organizationId, status])
+}
+
+model AgentRole {
+  id                   String           @id @default(cuid())
+  teamId               String
+  name                 String
+  slug                 String
+  category             String
+  description          String
+  responsibilities     String           @default("[]")
+  requiredCapabilities String           @default("[]")
+  modelPolicy          String           @default("benchmark_selected")
+  skills               String           @default("[]")
+  plugins              String           @default("[]")
+  permissions          String           @default("[]")
+  concurrencyLimit     Int              @default(1)
+  isLead               Boolean          @default(false)
+  status               String           @default("active")
+  createdAt            DateTime         @default(now())
+  updatedAt            DateTime         @updatedAt
+  team                 Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
+  workItems            WorkItem[]
+  roleCapabilities     RoleCapability[]
+
+  @@unique([teamId, slug])
+  @@index([teamId, category, status])
+}
+
+model CapabilityAsset {
+  id             String           @id @default(cuid())
+  organizationId String
+  kind           String
+  name           String
+  version        String           @default("unversioned")
+  status         String           @default("candidate")
+  riskLevel      String           @default("YELLOW")
+  sourceUrl      String?
+  evidence       String           @default("[]")
+  metadata       String           @default("{}")
+  createdAt      DateTime         @default(now())
+  updatedAt      DateTime         @updatedAt
+  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
+  roles          RoleCapability[]
+
+  @@unique([organizationId, kind, name, version])
+  @@index([organizationId, kind, status])
+}
+
+model RoleCapability {
+  roleId        String
+  capabilityId  String
+  required      Boolean         @default(true)
+  configuration String          @default("{}")
+  role          AgentRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
+  capability    CapabilityAsset @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
+
+  @@id([roleId, capabilityId])
+}
+
+model Mission {
+  id               String           @id @default(cuid())
+  organizationId   String
+  teamId           String?
+  title            String
+  objective        String
+  missionType      String           @default("general")
+  status           String           @default("draft")
+  priority         String           @default("normal")
+  riskLevel        String           @default("GREEN")
+  approvalMode     String           @default("delegated")
+  budgetUsd        Float            @default(1)
+  estimatedCostUsd Float            @default(0)
+  successCriteria  String           @default("[]")
+  constraints      String           @default("[]")
+  input            String           @default("{}")
+  currentStage     String           @default("intake")
+  leaseOwner       String?
+  leaseExpiresAt   DateTime?
+  deadline         DateTime?
+  createdAt        DateTime         @default(now())
+  updatedAt        DateTime         @updatedAt
+  completedAt      DateTime?
+  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
+  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
+  workItems        WorkItem[]
+  evaluations      Evaluation[]
+  decisions        DecisionRecord[]
+  deliverables     Deliverable[]
+  events           MissionEvent[]
+  councilSessions  CouncilSession[]
+  runs             MissionRun[]
+  graphRuns        GraphRun[]
+  externalEffects  ExternalEffect[]
+  missionOrganizations MissionOrganization[]
+
+  @@index([organizationId, status])
+  @@index([teamId, status])
+}
+
+model MissionRun {
+  id               String       @id @default(cuid())
+  organizationId   String
+  missionId        String
+  idempotencyKey   String
+  requestHash      String
+  requestedBy      String
