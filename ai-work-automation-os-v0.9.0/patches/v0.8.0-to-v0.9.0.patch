-  GraphRiskLevel,
-  GraphVerificationProfile
-} from "@/lib/graph/types";
-
-export type GraphShadowSnapshot = {
-  graphStatus: string;
-  currentNodeKey: string;
-  routeClass: "direct" | "complex";
-  riskLevel: GraphRiskLevel;
-  reversibility: GraphReversibility;
-  approvalRequired: boolean;
-  researchFanOut: number;
-  maxParallel: number;
-  modelClass: GraphModelClass;
-  verificationProfile: GraphVerificationProfile;
-  projectedCostMicros: string;
-  transitionCount: number;
-};
-
-export type LegacyMissionSnapshot = {
-  status: string | null;
-  evidenceMode: "unknown" | "synthetic" | "observed" | "mixed";
-  estimatedCostMicros: string;
-  externalEffectsObserved: number;
-};
-
-export type GraphShadowAssessment = {
-  schemaVersion: "graph-shadow-assessment.v1";
-  status: "compatible" | "needs_review" | "blocked";
-  mismatchCodes: string[];
-  riskCodes: string[];
-  graph: GraphShadowSnapshot;
-  legacy: LegacyMissionSnapshot;
-  canaryEligible: boolean;
-};
-
-export class GraphShadowAssessmentError extends Error {
-  constructor(readonly code: string) {
-    super(code);
-  }
-}
-
-function micros(value: string, code: string): bigint {
-  if (!/^\d{1,30}$/.test(value)) {
-    throw new GraphShadowAssessmentError(code);
-  }
-  return BigInt(value);
-}
-
-export function assessGraphShadow(input: {
-  graph: GraphShadowSnapshot;
-  legacy: LegacyMissionSnapshot;
-  hardCostLimitMicros: string;
-}): GraphShadowAssessment {
-  const mismatchCodes: string[] = [];
-  const riskCodes: string[] = [];
-  const hardLimit = micros(input.hardCostLimitMicros, "shadow_hard_limit_invalid");
-  const projected = micros(input.graph.projectedCostMicros, "shadow_graph_cost_invalid");
-  const legacyCost = micros(input.legacy.estimatedCostMicros, "shadow_legacy_cost_invalid");
-
-  if (input.graph.graphStatus !== "shadow_completed") {
-    mismatchCodes.push("graph_shadow_not_completed");
-  }
-  if (input.legacy.status === null) {
-    mismatchCodes.push("legacy_status_missing");
-  } else if (input.legacy.status === "failed") {
-    mismatchCodes.push("legacy_execution_failed");
-  }
-  if (
-    input.graph.approvalRequired &&
-    (input.legacy.status === "completed" || input.legacy.status === "simulated")
-  ) {
-    riskCodes.push("legacy_completed_despite_graph_approval_requirement");
-  }
-  if (
-    (input.graph.riskLevel === "RED" ||
-      input.graph.reversibility === "irreversible") &&
-    !input.graph.approvalRequired
-  ) {
-    riskCodes.push("graph_risk_gate_missing");
-  }
-  if (
-    input.graph.verificationProfile === "light" &&
-    (input.graph.riskLevel !== "GREEN" || input.graph.routeClass === "complex")
-  ) {
-    mismatchCodes.push("verification_profile_too_light");
-  }
-  if (input.graph.researchFanOut > 4 || input.graph.maxParallel > 4) {
-    mismatchCodes.push("adaptive_limits_above_initial_canary");
-  }
-  if (projected > hardLimit || legacyCost > hardLimit) {
-    riskCodes.push("cost_above_shadow_hard_limit");
-  }
-  if (
-    input.legacy.externalEffectsObserved > 0 &&
-    input.graph.riskLevel === "GREEN"
-  ) {
-    riskCodes.push("external_effect_observed_on_green_route");
-  }
-  if (
-    input.legacy.evidenceMode === "unknown" &&
-    (input.legacy.status === "completed" || input.legacy.status === "simulated")
-  ) {
-    mismatchCodes.push("legacy_completion_without_evidence_mode");
-  }
-  if (
-    input.graph.routeClass === "direct" &&
-    input.graph.verificationProfile === "adversarial"
-  ) {
-    mismatchCodes.push("direct_route_with_adversarial_profile");
-  }
-
-  const status =
-    riskCodes.length > 0
-      ? "blocked"
-      : mismatchCodes.length > 0
-        ? "needs_review"
-        : "compatible";
-
-  return {
-    schemaVersion: "graph-shadow-assessment.v1",
-    status,
-    mismatchCodes,
-    riskCodes,
-    graph: input.graph,
-    legacy: input.legacy,
-    canaryEligible:
-      status === "compatible" &&
-      input.graph.riskLevel === "GREEN" &&
-      input.graph.reversibility === "reversible" &&
-      input.legacy.externalEffectsObserved === 0 &&
-      projected <= hardLimit &&
-      legacyCost <= hardLimit
-  };
-}
