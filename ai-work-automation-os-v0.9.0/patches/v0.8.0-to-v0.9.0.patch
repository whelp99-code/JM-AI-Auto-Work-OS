-    throw new GraphRoleContractError("research_findings_invalid");
-  }
-  const findings = value.findings.map((item) => {
-    if (!isPlainObject(item)) {
-      throw new GraphRoleContractError("research_finding_invalid");
-    }
-    strictKeys(item, ["claim", "evidenceRefs", "confidence"], "research_finding_unknown_field");
-    return {
-      claim: stringValue(item.claim, "research_claim_invalid"),
