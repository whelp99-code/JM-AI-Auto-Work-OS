-function runtimeGraphForSpecHash(specHash: string) {
-  if (specHash === compiledDefaultGraph.specHash) {
-    return {
-      compiled: compiledDefaultGraph,
-      predicates: defaultGraphPredicateRegistry,
-      policyVersion: getGraphPolicyVersion(),
-      legacy: false
-    } as const;
-  }
-  if (specHash === compiledLegacyGraph.specHash) {
-    return {
-      compiled: compiledLegacyGraph,
-      predicates: legacyDefaultGraphPredicateRegistry,
-      policyVersion: workflowLegacyCompatibility.policyVersion,
-      legacy: true
-    } as const;
-  }
-  throw new GraphRuntimeError("graph_spec_hash_mismatch", 409);
-}
