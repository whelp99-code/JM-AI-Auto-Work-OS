-
-export function useMissionWorkspace(missionRunId: string) {
-  const [workspace, setWorkspace] = useState<MissionWorkspaceSnapshot | null>(null);
-  const [loading, setLoading] = useState(true);
-  const [refreshing, setRefreshing] = useState(false);
-  const [error, setError] = useState<string | null>(null);
-  const [autoRefresh, setAutoRefresh] = useState(true);
-  const [lastUpdatedAt, setLastUpdatedAt] = useState<string | null>(null);
-  const mounted = useRef(true);
-  const requestSequence = useRef(0);
-
-  const load = useCallback(
-    async (background = false) => {
-      if (!missionRunId) return;
-      const sequence = ++requestSequence.current;
-      background ? setRefreshing(true) : setLoading(true);
-      try {
-        const response = await workspaceRequest<{ workspace: MissionWorkspaceSnapshot }>(
-          `/api/company/runs/${encodeURIComponent(missionRunId)}/workspace`,
-          { cache: "no-store" }
-        );
-        if (!mounted.current || sequence !== requestSequence.current) return;
-        setWorkspace(response.workspace);
-        setLastUpdatedAt(new Date().toISOString());
-        setError(null);
-      } catch (caught) {
-        if (!mounted.current || sequence !== requestSequence.current) return;
-        const message =
-          caught instanceof WorkspaceApiError
-            ? `${caught.message} (${caught.status})`
-            : caught instanceof Error
-              ? caught.message
-              : "mission_workspace_load_failed";
-        setError(message);
-      } finally {
-        if (mounted.current && sequence === requestSequence.current) {
-          setLoading(false);
-          setRefreshing(false);
-        }
-      }
-    },
-    [missionRunId]
-  );
-
-  useEffect(() => {
-    mounted.current = true;
-    void load(false);
-    const reloadAfterAuth = () => void load(false);
-    window.addEventListener(WORKSPACE_AUTH_CHANGED_EVENT, reloadAfterAuth);
-    return () => {
-      mounted.current = false;
-      requestSequence.current += 1;
-      window.removeEventListener(WORKSPACE_AUTH_CHANGED_EVENT, reloadAfterAuth);
-    };
-  }, [load]);
-
-  useEffect(() => {
-    if (!autoRefresh || workspace?.summary.terminal) return;
-    const timer = window.setInterval(() => {
-      if (document.visibilityState === "visible") void load(true);
-    }, 4_000);
-    return () => window.clearInterval(timer);
-  }, [autoRefresh, load, workspace?.summary.terminal]);
-
-  useEffect(() => {
-    const onVisible = () => {
-      if (
-        document.visibilityState === "visible" &&
-        autoRefresh &&
-        !workspace?.summary.terminal
-      ) {
-        void load(true);
-      }
-    };
-    document.addEventListener("visibilitychange", onVisible);
-    return () => document.removeEventListener("visibilitychange", onVisible);
