+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "sqlite"
+  url      = env("DATABASE_URL")
+}
+
+model CouncilSession {
+  id               String                @id @default(cuid())
+  missionId        String?
+  question         String
+  status           String                @default("draft")
+  participants     String
+  budgetUsd        Float                 @default(0.5)
+  estimatedCostUsd Float                 @default(0)
+  source           String                @default("native")
+  createdAt        DateTime              @default(now())
+  updatedAt        DateTime              @updatedAt
+  completedAt      DateTime?
+  rounds           CouncilRound[]
+  responses        ParticipantResponse[]
+  consensus        Consensus?
+  artifacts        Artifact[]
+  auditEvents      AuditEvent[]
+  mission          Mission?              @relation(fields: [missionId], references: [id], onDelete: SetNull)
+
+  @@index([missionId])
+}
+
+model CouncilRound {
+  id          String                @id @default(cuid())
+  sessionId   String
+  roundNumber Int
+  type        String
+  prompt      String
+  status      String                @default("completed")
+  createdAt   DateTime              @default(now())
+  session     CouncilSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+  responses   ParticipantResponse[]
+
+  @@unique([sessionId, roundNumber, type])
+}
+
+model ParticipantResponse {
+  id           String         @id @default(cuid())
+  sessionId    String
+  roundId      String?
+  provider     String
+  role         String
+  status       String         @default("success")
+  content      String
+  model        String?
+  promptTokens Int            @default(0)
+  outputTokens Int            @default(0)
+  costUsd      Float          @default(0)
+  latencyMs    Int            @default(0)
+  errorCode    String?
+  rawMetadata  String?
+  createdAt    DateTime       @default(now())
+  session      CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+  round        CouncilRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
+}
+
+model Consensus {
+  id                 String         @id @default(cuid())
+  sessionId          String         @unique
+  agreements         String
+  conflicts          String
+  decision           String
+  confidence         Float          @default(0.7)
+  userEditedDecision String?
+  createdAt          DateTime       @default(now())
+  updatedAt          DateTime       @updatedAt
+  session            CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+}
+
+model Artifact {
+  id        String         @id @default(cuid())
+  sessionId String
+  type      String
+  version   Int
+  markdown  String
+  createdAt DateTime       @default(now())
+  session   CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
+
+  @@unique([sessionId, type, version])
+}
+
+model AuditEvent {
+  id        String          @id @default(cuid())
+  sessionId String?
+  type      String
+  message   String
+  metadata  String?
+  createdAt DateTime        @default(now())
+  session   CouncilSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
+}
+
+model ImportError {
+  id         String   @id @default(cuid())
+  sourcePath String
+  message    String
+  createdAt  DateTime @default(now())
+}
+
+model Organization {
+  id               String             @id @default(cuid())
+  name             String
+  slug             String             @unique
+  status           String             @default("active")
+  createdAt        DateTime           @default(now())
+  updatedAt        DateTime           @updatedAt
+  teams            Team[]
+  missions         Mission[]
+  missionRuns      MissionRun[]
+  memberships      OrganizationMembership[]
+  externalEffects  ExternalEffect[]
