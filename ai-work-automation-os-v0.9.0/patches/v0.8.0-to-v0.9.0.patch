-export function decideOrganizationRuntimeMode(input: {
-  requestedMode: OrganizationRuntimeMode;
-  organizationId: string;
-  riskLevel: string;
-  budgetMicros: string;
-  maxBudgetMicros?: string;
-  allowlist?: string;
-}): {
-  requestedMode: OrganizationRuntimeMode;
-  effectiveMode: OrganizationRuntimeMode;
-  riskLevel: OrganizationRiskLevel;
-  reasonCodes: string[];
-} {
-  const riskLevel: OrganizationRiskLevel =
-    input.riskLevel === "RED" ? "RED" : input.riskLevel === "YELLOW" ? "YELLOW" : "GREEN";
-  const allowlist = new Set(
-    (input.allowlist ?? process.env.ORGANIZATION_ACTIVE_ORGANIZATION_IDS ?? "")
-      .split(",")
-      .map((item) => item.trim())
-      .filter(Boolean)
-  );
-  const reasonCodes: string[] = [];
-
-  if (input.requestedMode === "disabled") {
-    return { requestedMode: input.requestedMode, effectiveMode: "disabled", riskLevel, reasonCodes: ["runtime.disabled"] };
-  }
-
-  if (input.requestedMode === "shadow") {
-    return { requestedMode: input.requestedMode, effectiveMode: "shadow", riskLevel, reasonCodes: ["runtime.shadow"] };
-  }
-
-  if (riskLevel !== "GREEN") {
-    reasonCodes.push("active.requires_green_risk");
-  }
-  if (allowlist.size === 0) {
-    reasonCodes.push("active.allowlist_empty");
-  } else if (!allowlist.has("*") && !allowlist.has(input.organizationId)) {
-    reasonCodes.push("active.organization_not_allowlisted");
-  }
-  if (!/^(0|[1-9][0-9]*)$/.test(input.budgetMicros)) {
-    reasonCodes.push("active.invalid_budget");
-  } else {
-    const maxBudgetMicros = input.maxBudgetMicros ?? "25000000";
-    if (!/^(0|[1-9][0-9]*)$/.test(maxBudgetMicros)) {
-      reasonCodes.push("active.invalid_max_budget");
-    } else if (BigInt(input.budgetMicros) > BigInt(maxBudgetMicros)) {
-      reasonCodes.push("active.budget_exceeds_policy");
-    }
-  }
-
-  return {
-    requestedMode: input.requestedMode,
-    effectiveMode: reasonCodes.length === 0 ? "active" : "shadow",
-    riskLevel,
-    reasonCodes: reasonCodes.length === 0 ? ["active.policy_eligible"] : reasonCodes
-  };
-}
