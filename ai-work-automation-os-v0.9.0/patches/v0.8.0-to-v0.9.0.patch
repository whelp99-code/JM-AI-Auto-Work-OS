-export const WORKFLOW_MODEL_METADATA = Object.freeze({
-  task: "work_automation_task",
-  role: "work_automation_role"
-});
-
-export const WORKFLOW_WEBHOOK_HEADERS = Object.freeze({
-  timestamp: "x-work-automation-timestamp",
-  signature: "x-work-automation-signature",
-  requestId: "x-work-automation-request-id"
-});
-
-const LEGACY_DEFAULT_SPEC_KEY = "proofgraph.default";
-const LEGACY_POLICY_VERSION = "proofgraph.policy.v1";
-const LEGACY_PREFIX = "proofgraph.";
-const LEGACY_WEBHOOK_HEADERS = Object.freeze({
-  timestamp: "x-proofgraph-timestamp",
-  signature: "x-proofgraph-signature",
-  requestId: "x-proofgraph-request-id"
-});
-
-export const workflowLegacyCompatibility = Object.freeze({
-  defaultSpecKey: LEGACY_DEFAULT_SPEC_KEY,
-  policyVersion: LEGACY_POLICY_VERSION,
-  prefix: LEGACY_PREFIX,
-  webhookHeaders: LEGACY_WEBHOOK_HEADERS
-});
-
-export function canonicalizeWorkflowSpecKey(value: string): string {
-  const key = value.trim();
-  if (key === LEGACY_DEFAULT_SPEC_KEY) return WORKFLOW_DEFAULT_SPEC_KEY;
-  if (key.startsWith(LEGACY_PREFIX)) {
-    return `work-automation.workflow.${key.slice(LEGACY_PREFIX.length)}`;
-  }
-  return key;
-}
-
-export function isAcceptedWorkflowPolicyVersion(
-  value: string,
-  expected = WORKFLOW_POLICY_VERSION
-): boolean {
-  return value === expected || value === LEGACY_POLICY_VERSION;
-}
-
-export function workflowWebhookResponseHeaders(headers: Headers): {
-  timestamp: string;
-  signature: string;
-} {
-  return {
