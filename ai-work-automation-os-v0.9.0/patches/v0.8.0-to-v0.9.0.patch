-
-type SupabaseAuthError = {
-  status?: number;
-  message?: string;
-};
-
-type SupabaseGetUserResult = {
-  data: { user: SupabaseUser | null };
-  error: SupabaseAuthError | null;
-};
-
-export type DeferredSupabaseAuthClient = {
-  auth: {
-    getUser(accessToken: string): Promise<SupabaseGetUserResult>;
-  };
-};
-
-let authClient: DeferredSupabaseAuthClient | undefined;
-
-function requiredEnvironmentVariable(name: string): string {
-  const value = process.env[name]?.trim();
-  if (!value) throw new Error(`missing_environment_variable:${name}`);
-  return value;
-}
-
-function normalizedProjectUrl(value: string): string {
-  const parsed = new URL(value);
-  if (
-    parsed.protocol !== "https:" ||
-    parsed.username ||
-    parsed.password ||
-    parsed.search ||
-    parsed.hash
-  ) {
-    throw new Error("invalid_environment_variable:NEXT_PUBLIC_SUPABASE_URL");
-  }
-  return parsed.origin;
-}
-
-async function getUserViaRest(
-  projectUrl: string,
-  publishableKey: string,
-  accessToken: string
-): Promise<SupabaseGetUserResult> {
-  const controller = new AbortController();
-  const timeout = setTimeout(() => controller.abort(), 10_000);
-  try {
-    const response = await fetch(`${projectUrl}/auth/v1/user`, {
-      method: "GET",
-      headers: {
-        apikey: publishableKey,
-        authorization: `Bearer ${accessToken}`,
-        accept: "application/json"
-      },
-      cache: "no-store",
-      signal: controller.signal
-    });
-    let payload: unknown = null;
-    try {
-      payload = await response.json();
-    } catch {
-      payload = null;
-    }
-    if (!response.ok) {
-      const message =
-        payload && typeof payload === "object" && "message" in payload
-          ? String((payload as { message?: unknown }).message ?? "")
-          : `http_${response.status}`;
-      return {
-        data: { user: null },
-        error: { status: response.status, message }
-      };
-    }
-    if (!payload || typeof payload !== "object") {
-      return {
-        data: { user: null },
-        error: { status: 502, message: "supabase_user_response_invalid" }
-      };
-    }
-    const candidate = payload as Partial<SupabaseUser>;
-    if (typeof candidate.id !== "string" || candidate.id.length < 1) {
-      return {
-        data: { user: null },
-        error: { status: 502, message: "supabase_user_response_invalid" }
-      };
-    }
-    return {
-      data: {
-        user: {
-          id: candidate.id,
-          email: typeof candidate.email === "string" ? candidate.email : null,
-          app_metadata:
-            candidate.app_metadata && typeof candidate.app_metadata === "object"
-              ? candidate.app_metadata
-              : {}
-        }
-      },
-      error: null
-    };
-  } finally {
-    clearTimeout(timeout);
-  }
-}
-
-/**
- * Deferred server-side Supabase Auth adapter.
- *
- * Local-first installations do not initialize or require Supabase. When a
- * future multi-user deployment explicitly selects COMPANY_AUTH_MODE=supabase,
- * this adapter validates the bearer token through the Auth REST endpoint.
- */
-export function getSupabaseAuthClient(): DeferredSupabaseAuthClient {
-  if (authClient) return authClient;
-
-  const projectUrl = normalizedProjectUrl(
-    requiredEnvironmentVariable("NEXT_PUBLIC_SUPABASE_URL")
-  );
-  const publishableKey = requiredEnvironmentVariable(
-    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY"
-  );
-
-  authClient = {
-    auth: {
-      getUser: (accessToken) =>
-        getUserViaRest(projectUrl, publishableKey, accessToken)
-    }
-  };
-  return authClient;
-}
