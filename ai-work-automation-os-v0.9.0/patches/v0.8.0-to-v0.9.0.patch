-          item !== null && typeof item === "object" && !Array.isArray(item)
-      )
-    : [];
-}
-
-function omit(input: JsonRecord, keys: readonly string[]): JsonRecord {
-  const output = { ...input };
-  for (const key of keys) delete output[key];
-  return output;
