-        output: { exhausted },
-        stateDelta: {
-          currentPhase: "budget_guard",
-          lastSignal: exhausted ? "budget_exhausted" : "budget_available",
-          ...(exhausted ? { finalStatus: "partial" as const } : {})
-        },
-        signals: [{ code: exhausted ? "budget_exhausted" : "budget_available" }]
-      });
-    }
-
-    case "triage": {
-      const decision = deriveAdaptiveRoute({
-        objective: context.state.objective,
-        requirements: context.state.requirements,
-        constraints: context.state.constraints,
-        riskLevel: context.state.classification.riskLevel,
-        reversibility: context.state.classification.reversibility,
-        budget: context.state.budget,
-        limits: {
