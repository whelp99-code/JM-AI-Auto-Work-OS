- * ProofGraph is a separate software-development agent project. New records use
- * the work-automation namespace. Legacy identifiers are accepted only at the
- * compatibility boundary during migration and resume.
- */
-export const WORKFLOW_DEFAULT_SPEC_KEY = "work-automation.workflow.default";
-export const WORKFLOW_POLICY_VERSION = "work-automation.workflow-policy.v1";
-export const WORKFLOW_RUNTIME_CAPABILITIES_SCHEMA =
-  "work-automation-runtime-capabilities.v1";
