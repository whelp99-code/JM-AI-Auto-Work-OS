-}): MissionCanaryFacts {
-  if (
-    !Number.isFinite(input.budgetUsd) ||
-    input.budgetUsd < 0 ||
-    input.budgetUsd > Number.MAX_SAFE_INTEGER / 1_000_000
-  ) {
-    throw new GraphCanaryPolicyError("graph_canary_mission_budget_invalid");
-  }
-
-  let riskLevel = normalizedRisk(input.missionRiskLevel);
-  let inferredExternalEffects = false;
-  for (const workItem of input.workItems) {
-    riskLevel = higherRisk(riskLevel, normalizedRisk(workItem.riskLevel));
-    if (!internalCanaryActionKinds.has(workItem.actionKind)) {
-      inferredExternalEffects = true;
-    }
-  }
-
-  const declared = declaredCanaryFacts(input.missionInputJson);
-  const inferredReversibility = riskReversibility(riskLevel);
-  const reversibility = lessReversible(
-    inferredReversibility,
-    declared.reversibility ??
