-$$;
-
-revoke all on function app_private.mission_queue_send(jsonb, integer) from public;
-revoke all on function app_private.mission_queue_read(integer, integer) from public;
-revoke all on function app_private.mission_queue_delete(bigint) from public;
-revoke all on function app_private.mission_queue_archive(bigint) from public;
-revoke all on function app_private.mission_queue_set_vt(bigint, integer) from public;
-revoke all on function app_private.mission_queue_exists(bigint) from public;
-
-do $$
-begin
