-        (entry) =>
-          entry.enabled &&
-          !excluded.has(entry.id) &&
-          entry.roles.includes(input.role as LiveGraphRole) &&
-          entry.modelClasses.includes(modelClass)
-      )
-      .sort((left, right) => {
-        const leftProvider = providerRank.get(left.provider) ?? 10_000;
-        const rightProvider = providerRank.get(right.provider) ?? 10_000;
-        return (
-          leftProvider - rightProvider ||
-          left.priority - right.priority ||
-          left.id.localeCompare(right.id)
-        );
-      });
-
-    if (candidates.length > 0) sawConfigured = true;
-
-    for (const entry of candidates) {
-      const outputTokens = Math.min(
-        input.requestedOutputTokens,
-        entry.maxOutputTokens
-      );
-      const estimatedCostMicros = calculateGraphModelCostMicros({
-        entry,
-        inputTokens: input.estimatedInputTokens,
-        outputTokens
-      });
-      if (BigInt(estimatedCostMicros) > BigInt(input.remainingCostMicros)) {
-        continue;
-      }
-      sawBudgetCandidate = true;
-      return {
-        entry,
-        requestedClass: input.requestedClass,
-        selectedClass: modelClass,
-        reasonCodes: [
-          `role:${input.role}`,
-          `requested_class:${input.requestedClass}`,
-          `selected_class:${modelClass}`,
-          ...(modelClass === input.requestedClass
-            ? ["class_exact_match"]
-            : ["class_downgraded_for_budget_or_availability"]),
-          `registry:${input.registry.version}`
-        ],
-        estimatedInputTokens: input.estimatedInputTokens,
-        estimatedOutputTokens: outputTokens,
-        estimatedCostMicros
-      };
-    }
-  }
-
-  if (!sawConfigured) {
-    throw new GraphModelRouterError("model_route_not_configured");
-  }
-  if (!sawBudgetCandidate) {
-    throw new GraphModelRouterError("model_route_budget_exceeded");
-  }
-  throw new GraphModelRouterError("model_route_unavailable");
-}
