-function validatePlanner(value: Record<string, unknown>): PlannerRoleOutput {
-  strictKeys(value, ["kind", "summary", "steps", "risks", "assumptions"], "planner_output_unknown_field");
-  if (!Array.isArray(value.steps) || value.steps.length === 0 || value.steps.length > 100) {
-    throw new GraphRoleContractError("planner_steps_invalid");
-  }
-  const ids = new Set<string>();
-  const steps = value.steps.map((item) => {
-    if (!isPlainObject(item)) throw new GraphRoleContractError("planner_step_invalid");
-    strictKeys(item, ["id", "title", "acceptanceCriteria", "dependencies"], "planner_step_unknown_field");
-    const id = stringValue(item.id, "planner_step_id_invalid", 128);
-    if (!identifierPattern.test(id) || ids.has(id)) {
-      throw new GraphRoleContractError("planner_step_id_invalid");
-    }
-    ids.add(id);
-    return {
-      id,
-      title: stringValue(item.title, "planner_step_title_invalid", 1_000),
-      acceptanceCriteria: stringArray(item.acceptanceCriteria, "planner_acceptance_invalid", 100),
-      dependencies: stringArray(item.dependencies, "planner_dependencies_invalid", 100, 128)
-    };
-  });
-  for (const step of steps) {
-    if (step.dependencies.some((dependency) => !ids.has(dependency))) {
-      throw new GraphRoleContractError("planner_dependency_unknown");
-    }
-  }
-  if (!Array.isArray(value.risks) || value.risks.length > 100) {
-    throw new GraphRoleContractError("planner_risks_invalid");
-  }
-  const risks = value.risks.map((item) => {
-    if (!isPlainObject(item)) throw new GraphRoleContractError("planner_risk_invalid");
