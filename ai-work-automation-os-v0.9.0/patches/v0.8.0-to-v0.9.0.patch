-      headers.get(LEGACY_WEBHOOK_HEADERS.timestamp) ??
-      "",
-    signature:
-      headers.get(WORKFLOW_WEBHOOK_HEADERS.signature) ??
-      headers.get(LEGACY_WEBHOOK_HEADERS.signature) ??
-      ""
-  };
-}
