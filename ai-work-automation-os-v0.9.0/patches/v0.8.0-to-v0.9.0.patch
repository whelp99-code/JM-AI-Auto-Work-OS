-
-export class CompanyAuthError extends Error {
-  readonly status: number;
-
-  constructor(message: string, status: number) {
-    super(message);
-    this.status = status;
-  }
-}
-
-function normalizedOrigin(value: string, name: string): string {
-  try {
-    const url = new URL(value);
-
-    if (
-      (url.protocol !== "http:" && url.protocol !== "https:") ||
-      url.username ||
-      url.password ||
-      url.pathname !== "/" ||
-      url.search ||
-      url.hash
-    ) {
-      throw new Error("invalid_origin");
-    }
-
-    return url.origin;
-  } catch {
-    throw new CompanyAuthError(`invalid_environment_variable:${name}`, 503);
-  }
-}
-
-function firstForwardedValue(value: string | null): string | null {
-  const first = value?.split(",", 1)[0]?.trim();
-  return first || null;
-}
-
-function trustedProxyOrigin(request: Request): string | null {
-  if (process.env.COMPANY_TRUST_PROXY_HEADERS?.trim() !== "true") return null;
-
-  const host = firstForwardedValue(request.headers.get("x-forwarded-host"));
-  const protocol = firstForwardedValue(
-    request.headers.get("x-forwarded-proto")
-  )?.toLowerCase();
-
-  if (
-    !host ||
-    (protocol !== "http" && protocol !== "https") ||
-    host.length > 255 ||
-    !/^[A-Za-z0-9.-]+(?::\d{1,5})?$/.test(host)
-  ) {
-    throw new CompanyAuthError("proxy_origin_invalid", 403);
-  }
-
-  return `${protocol}://${host}`;
-}
-
-function allowedRequestOrigins(request: Request): Set<string> {
-  const requestUrl = new URL(request.url);
-  const allowed = new Set<string>([requestUrl.origin]);
-  const configuredOrigin = process.env.COMPANY_PUBLIC_ORIGIN?.trim();
-
-  if (configuredOrigin) {
-    allowed.add(normalizedOrigin(configuredOrigin, "COMPANY_PUBLIC_ORIGIN"));
-  }
-
-  const proxyOrigin = trustedProxyOrigin(request);
-  if (proxyOrigin) allowed.add(proxyOrigin);
-
-  return allowed;
-}
-
-export function assertSameOrigin(request: Request): void {
-  const origin = request.headers.get("origin")?.trim();
-  if (!origin) return;
-
-  let normalized: string;
-
-  try {
-    normalized = new URL(origin).origin;
-  } catch {
-    throw new CompanyAuthError("origin_forbidden", 403);
-  }
-
-  if (normalized !== origin || !allowedRequestOrigins(request).has(normalized)) {
-    throw new CompanyAuthError("origin_forbidden", 403);
-  }
-}
-
-export function assertLocalOnlyRequest(request: Request): void {
-  assertSameOrigin(request);
-
-  const configuredBind =
-    process.env.COMPANY_LOCAL_BIND_ADDRESS?.trim() || "127.0.0.1";
-
-  if (!isLoopbackHostname(configuredBind)) {
-    throw new CompanyAuthError(
-      "local_mode_requires_loopback_bind_address",
-      503
-    );
-  }
-
-  if (!localRequestHostAllowed(request.url)) {
-    throw new CompanyAuthError("local_mode_loopback_only", 403);
-  }
-
-  for (const header of ["x-forwarded-for", "x-real-ip"]) {
-    const supplied = firstForwardedValue(request.headers.get(header));
-    if (supplied && !isLoopbackHostname(supplied)) {
-      throw new CompanyAuthError("local_mode_proxy_forbidden", 403);
-    }
-  }
-}
-
-export function authorizeCompanyMutation(request: Request): string {
-  assertSameOrigin(request);
-
-  const configuredToken = process.env.COMPANY_CEO_TOKEN;
-
-  if (!configuredToken || Buffer.byteLength(configuredToken, "utf8") < 32) {
-    throw new CompanyAuthError("ceo_auth_not_configured", 503);
-  }
-
-  const suppliedToken = request.headers.get("x-company-ceo-token");
-
-  if (!suppliedToken) {
-    throw new CompanyAuthError("ceo_auth_required", 401);
-  }
-
-  if (Buffer.byteLength(suppliedToken, "utf8") > 4_096) {
-    throw new CompanyAuthError("ceo_auth_invalid", 403);
-  }
-
-  const configured = Buffer.from(configuredToken, "utf8");
-  const supplied = Buffer.from(suppliedToken, "utf8");
-
-  if (
-    configured.length !== supplied.length ||
-    !timingSafeEqual(configured, supplied)
-  ) {
-    throw new CompanyAuthError("ceo_auth_invalid", 403);
-  }
-
-  return "ceo:local-token";
-}
