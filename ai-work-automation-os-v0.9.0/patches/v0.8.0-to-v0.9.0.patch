-    throw new Error("graph_value_cyclic");
-  }
-
-  seen.add(value);
-
-  try {
-    if (Array.isArray(value)) {
-      return value.map((item) =>
-        canonicalize(item, seen, depth + 1, maximumDepth)
-      );
-    }
-
-    const prototype = Object.getPrototypeOf(value);
-
-    if (prototype !== Object.prototype && prototype !== null) {
-      throw new Error("graph_value_not_plain_object");
-    }
-
-    if (Object.getOwnPropertySymbols(value).length > 0) {
-      throw new Error("graph_value_symbol_key_forbidden");
-    }
-
-    const output: Record<string, unknown> = Object.create(null) as Record<
-      string,
-      unknown
-    >;
-    const descriptors = Object.getOwnPropertyDescriptors(value);
-
-    for (const key of Object.getOwnPropertyNames(value).sort()) {
-      if (forbiddenKeys.has(key)) {
-        throw new Error("graph_value_forbidden_key");
-      }
-
-      const descriptor = descriptors[key];
-      if (
-        !descriptor ||
-        descriptor.get !== undefined ||
-        descriptor.set !== undefined ||
-        descriptor.enumerable !== true
-      ) {
-        throw new Error("graph_value_accessor_forbidden");
-      }
-
-      const item = descriptor.value;
-
-      if (item === undefined) {
-        throw new Error("graph_value_not_json");
-      }
-
-      output[key] = canonicalize(item, seen, depth + 1, maximumDepth);
-    }
