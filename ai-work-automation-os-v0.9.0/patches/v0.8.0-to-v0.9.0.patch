-        where: {
-          id: effect.id,
-          status: effect.status,
-          updatedAt: effect.updatedAt
-        },
-        data: {
-          status,
-          result:
-            input.resolution === "confirmed_succeeded"
-              ? serializeExternalEffectResult(input.result)
-              : null,
-          providerRequestId: providerRequestId ?? effect.providerRequestId,
-          errorCode:
-            input.resolution === "confirmed_succeeded"
-              ? null
-              : input.resolution === "authorize_retry"
-                ? "external_effect_retry_authorized"
-                : "external_effect_confirmed_failed",
-          errorMessage: null,
-          reconciledBy: actor,
-          reconciliationNote: note,
-          reconciledAt: now,
-          completedAt:
-            input.resolution === "authorize_retry" ? null : now
