-const identifierPattern = /^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,191}$/;
-const safePathPattern = /^(?!\/)(?!.*(?:^|\/)\.\.(?:\/|$))(?!.*[\u0000-\u001f\\]).{1,512}$/;
-
-function isPlainObject(value: unknown): value is Record<string, unknown> {
-  return (
-    typeof value === "object" &&
-    value !== null &&
-    (Object.getPrototypeOf(value) === Object.prototype ||
-      Object.getPrototypeOf(value) === null)
-  );
-}
-
-function strictKeys(
-  value: Record<string, unknown>,
-  allowed: readonly string[],
-  code: string
-): void {
-  const allowedSet = new Set(allowed);
-  for (const key of Object.keys(value)) {
-    if (!allowedSet.has(key) || key === "__proto__" || key === "constructor") {
-      throw new GraphRoleContractError(code);
-    }
-  }
-}
-
-function stringValue(
-  value: unknown,
-  code: string,
-  maximum = 20_000,
-  allowEmpty = false
-): string {
-  if (typeof value !== "string") throw new GraphRoleContractError(code);
-  const result = value.trim();
-  if ((!allowEmpty && result.length === 0) || result.length > maximum) {
-    throw new GraphRoleContractError(code);
-  }
-  return result;
-}
-
-function stringArray(
-  value: unknown,
-  code: string,
-  maximumItems = 100,
-  maximumLength = 20_000
-): string[] {
-  if (!Array.isArray(value) || value.length > maximumItems) {
-    throw new GraphRoleContractError(code);
-  }
-  return value.map((item) => stringValue(item, code, maximumLength));
-}
-
-function numberRange(
-  value: unknown,
-  code: string,
-  minimum: number,
-  maximum: number
-): number {
-  if (
-    typeof value !== "number" ||
-    !Number.isFinite(value) ||
-    value < minimum ||
-    value > maximum
-  ) {
-    throw new GraphRoleContractError(code);
-  }
-  return value;
-}
