-export class OrganizationRuntimeError extends Error {
-  readonly status: number;
-  readonly details?: unknown;
-
-  constructor(message: string, status = 400, details?: unknown) {
-    super(message);
-    this.status = status;
-    this.details = details;
-  }
-}
-
-function parseStoredJson(value: string, errorCode: string): unknown {
-  try {
-    return JSON.parse(value) as unknown;
-  } catch {
-    throw new OrganizationRuntimeError(errorCode, 409);
-  }
-}
-
-
-function parseStoredStringArray(value: string, errorCode: string): string[] {
-  const parsed = parseStoredJson(value, errorCode);
-  if (!Array.isArray(parsed) || parsed.some((item) => typeof item !== "string")) {
-    throw new OrganizationRuntimeError(errorCode, 409);
-  }
-  return parsed as string[];
-}
-
-function parseStoredObject(value: string, errorCode: string): Record<string, unknown> {
-  const parsed = parseStoredJson(value, errorCode);
-  if (parsed === null || typeof parsed !== "object" || Array.isArray(parsed)) {
-    throw new OrganizationRuntimeError(errorCode, 409);
-  }
-  return parsed as Record<string, unknown>;
-}
-
-function usdToMicros(value: number): string {
-  if (!Number.isFinite(value) || value < 0) return "0";
-  return Math.round(value * 1_000_000).toString(10);
-}
-
-function runtimeMode(value: string): OrganizationRuntimeMode {
-  if (value === "disabled" || value === "shadow" || value === "active") {
-    return value;
-  }
-  throw new OrganizationRuntimeError("organization_runtime_mode_invalid", 500);
-}
