-
-  if (prepared.kind === "replay") {
-    if (!prepared.effect.result) {
-      throw new ExternalEffectError(
-        "A succeeded external effect has no stored result.",
-        "external_effect_result_missing",
-        false
-      );
-    }
-
-    return parseExternalEffectResult(prepared.effect.result) as T;
-  }
-
-  const claimed = await claimExternalEffect(context, prepared.effect);
-
-  try {
-    const result = await invoke({
-      idempotencyKey: claimed.effectKey,
-      fenceToken: missionFenceToken(context),
-      assertFence: assertCurrentMissionFence
