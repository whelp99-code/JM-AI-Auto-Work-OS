-function missionEstimatedCostUsd(mission: unknown): number | null {
-  try {
-    const value = (mission as { estimatedCostUsd?: unknown } | null | undefined)
-      ?.estimatedCostUsd;
-
-    return typeof value === "number" && Number.isFinite(value) && value >= 0
-      ? value
-      : null;
-  } catch {
-    return null;
-  }
-}
-
-function missionOutcome(mission: unknown): GraphStateV1["missionOutcome"] {
-  try {
-    const value = mission as
-      | {
-          status?: unknown;
-          id?: unknown;
-          currentStage?: unknown;
-          completedAt?: unknown;
-        }
-      | null
-      | undefined;
-    const status = typeof value?.status === "string" ? value.status : null;
-
-    return {
-      missionStatus: status,
-      summary: {
-        missionId: typeof value?.id === "string" ? value.id : null,
-        status,
-        currentStage:
-          typeof value?.currentStage === "string" ? value.currentStage : null,
-        completedAt:
-          value?.completedAt instanceof Date
-            ? value.completedAt.toISOString()
-            : typeof value?.completedAt === "string"
-              ? value.completedAt
-              : null
-      },
-      evidenceMode:
-        status === "simulated"
-          ? "synthetic"
-          : status === "completed"
-            ? "observed"
-            : "unknown"
-    };
-  } catch {
-    return {
-      missionStatus: null,
-      summary: null,
-      evidenceMode: "unknown"
-    };
-  }
-}
-
-function validationFailure(
-  state: GraphStateV1,
-  nodeKey: string
-): FailurePacketDraft | null {
-  if (nodeKey === "verify_final" && !state.synthesisArtifactRef) {
-    return {
-      failureType: "test_defect",
-      severity: "high",
-      blocking: true,
-      checkId: "synthesis.artifact.present",
-      evidenceRefs: [...state.verificationResultRefs],
-      expected: "A synthesized final artifact exists before final verification.",
-      observed: "Final verification was reached without a synthesis artifact.",
-      recommendedRoute: "verify",
-      retryable: true
-    };
-  }
-
-  const status = state.missionOutcome.missionStatus;
-
-  if (status === "completed" || status === "simulated") return null;
-
-  if (
-    status === "awaiting_executive" ||
-    status === "blocked" ||
-    status === "awaiting_revision"
-  ) {
-    return {
-      failureType: "security_risk",
-      severity: "high",
-      blocking: true,
-      checkId: "mission.authorization_or_revision",
-      evidenceRefs: [...state.implementationArtifactRefs],
-      expected: "Mission execution reaches a verified terminal state without bypassing required approval.",
-      observed: `Mission execution stopped with status ${status}.`,
-      recommendedRoute: "human",
-      retryable: false
-    };
-  }
-
-  if (status === "failed") {
-    return {
-      failureType: "execution_error",
-      severity: "high",
-      blocking: true,
-      checkId: "mission.execution.completed",
-      evidenceRefs: [...state.implementationArtifactRefs],
-      expected: "Mission work execution completes successfully.",
-      observed: "Mission execution returned failed.",
-      recommendedRoute: "execute",
-      retryable: true
-    };
-  }
-
-  return {
-    failureType: "tool_failure",
-    severity: "medium",
-    blocking: true,
-    checkId: "mission.execution.terminal",
-    evidenceRefs: [...state.implementationArtifactRefs],
-    expected: "Mission execution returns completed or simulated.",
-    observed: `Mission execution returned non-terminal status ${status ?? "unknown"}.`,
-    recommendedRoute: "execute",
-    retryable: true
-  };
-}
-
-export function buildResearchBranchInputs(
-  state: GraphStateV1
-): Array<{ index: number; question: string }> {
-  const candidates =
-    state.requirements.length > 0
-      ? state.requirements
-      : [state.objective];
-  const count = Math.min(Math.max(state.route.researchFanOut, 1), 32);
-  const lenses = [
-    "primary evidence",
-    "counter-evidence and failure modes",
-    "execution constraints",
-    "security and operational risk",
-    "independent reproduction"
-  ];
-
-  return Array.from({ length: count }, (_, index) => ({
-    index,
-    question: `${candidates[index % candidates.length] ?? state.objective} — focus: ${
-      lenses[index % lenses.length]
-    }`
-  }));
-}
