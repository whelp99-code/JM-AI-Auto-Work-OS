-  init: { status?: number; headers?: Record<string, string> } = {}
-): NextResponse {
-  return NextResponse.json(body, {
-    status: init.status,
-    headers: { ...noStoreHeaders, ...init.headers }
-  });
-}
-
-export function companyApiErrorResponse(
-  error: unknown,
-  logEvent: string
-): NextResponse {
-  if (
-    error instanceof CompanyAuthError ||
-    error instanceof MissionRunError ||
-    error instanceof MissionRunRequestError
-  ) {
-    return companyJson({ error: error.message }, { status: error.status });
-  }
-
-  if (error instanceof GraphRuntimeError) {
-    return companyJson({ error: error.code }, { status: error.status });
-  }
-
-  if (error instanceof OrganizationRuntimeError) {
-    return companyJson(
-      { error: error.message, ...(error.details === undefined ? {} : { details: error.details }) },
-      { status: error.status }
-    );
-  }
-
-  if (error instanceof OrganizationCompilerError) {
-    return companyJson(
-      { error: error.message, issues: error.issues },
-      { status: 422 }
-    );
-  }
-
-  if (error instanceof ExternalEffectError) {
-    const status =
-      error.code.endsWith("_invalid")
-        ? 400
-        : error.code.endsWith("_mismatch") ||
-            error.code.includes("contended") ||
-            error.code.includes("busy") ||
-            error.code.includes("fence_lost") ||
-            error.code.includes("reconciliation_required") ||
-            error.code.includes("confirmed_failed")
-          ? 409
-          : 500;
-
-    return companyJson({ error: error.code }, { status });
-  }
-
-  if (error instanceof ZodError || error instanceof SyntaxError) {
-    return companyJson({ error: "invalid_request" }, { status: 400 });
-  }
-
-  const message = error instanceof Error ? error.message : "internal_error";
-  const knownStatus = serviceErrorStatus[message];
-
-  if (knownStatus) {
-    return companyJson({ error: message }, { status: knownStatus });
-  }
-
-  console.error(logEvent, { error: sanitizeMissionRunError(error) });
-  return companyJson({ error: "internal_error" }, { status: 500 });
-}
