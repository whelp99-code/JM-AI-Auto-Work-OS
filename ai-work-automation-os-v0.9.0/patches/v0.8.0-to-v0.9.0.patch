-function parseState(value: string, expectedHash: string): GraphStateV1 {
-  try {
-    const state = graphStateSchema.parse(JSON.parse(value) as unknown);
-    assertGraphStateIntegrity(state, expectedHash);
-    return state;
-  } catch (error) {
-    if (
-      error instanceof Error &&
-      error.message === "graph_state_hash_mismatch"
-    ) {
-      throw new GraphRuntimeError("graph_state_hash_mismatch", 409);
-    }
-    throw new GraphRuntimeError("graph_state_corrupted", 500);
-  }
-}
