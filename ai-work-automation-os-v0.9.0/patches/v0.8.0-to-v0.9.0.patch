-export async function executeConditionalMissionGraph(
-  input: ExecuteGraphMissionInput
-): Promise<GraphExecutionResult> {
-  const mode = input.stopBeforeEffects ? "shadow" : "conditional";
-  const fence: GraphRunFence = {
-    missionRunId: input.missionRun.id,
-    workerId: input.workerId,
-    leaseEpoch: input.missionRun.leaseEpoch
-  };
-  let graphRun = await ensureGraphRun({
-    missionRun: input.missionRun,
-    mode,
-    fence
-  });
-  graphRun = await recoverStaleGraphNodeRuns({
-    graphRun,
-    fence,
-    expectedMode: mode
-  });
-  const mission = await prisma.mission.findUnique({
-    where: { id: input.missionRun.missionId }
-  });
-  if (!mission) throw new GraphRuntimeError("mission_not_found", 404);
-  const maximumSteps = Math.max(
-    1,
-    graphRun.maxTransitions - graphRun.transitionCount + 1
-  );
-
-  try {
-    for (let step = 0; step < maximumSteps; step += 1) {
-      if (!runningGraphStatuses.has(graphRun.status)) break;
-      graphRun = await runOneGraphStep({
-        graphRun,
-        mission: missionSnapshot(mission),
-        fence,
-        executeMission: input.executeMission,
-        stopBeforeEffects: input.stopBeforeEffects === true
-      });
-    }
-  } catch (error) {
-    if (error instanceof GraphFenceLostError) throw error;
-
-    if (
-      isRetryableGraphExecutionError(error) &&
-      input.missionRun.attemptCount < input.missionRun.maxAttempts
-    ) {
-      await recordGraphInterrupted({
-        graphRunId: graphRun.id,
-        fence,
-        error
-      });
-      throw error;
-    }
-
-    graphRun = await markGraphFailed({
-      graphRunId: graphRun.id,
-      fence,
-      error
-    });
-  }
-
-  const latestMission = await prisma.mission.findUnique({
-    where: { id: input.missionRun.missionId }
-  });
-  const status = graphRun.status as GraphExecutionResult["status"];
-
-  return {
-    graphRunId: graphRun.id,
-    status,
-    mission: latestMission
-  };
-}
