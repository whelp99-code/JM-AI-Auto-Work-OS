-  }
-
-  if (
-    input.stopBeforeEffects &&
-    (node.kind === "agent" || node.kind === "fan_out" || node.kind === "approval")
-  ) {
-    return prisma.$transaction(async (tx) => {
-      await touchMissionRunFence(tx, input.fence);
-      const current = await tx.graphRun.findUniqueOrThrow({
-        where: { id: input.graphRun.id }
-      });
-      assertPinnedGraphRun({ graphRun: current, expectedMode: "shadow" });
-      if (
-        current.status !== "running" ||
-        current.stateVersion !== input.graphRun.stateVersion ||
-        current.stateHash !== input.graphRun.stateHash ||
