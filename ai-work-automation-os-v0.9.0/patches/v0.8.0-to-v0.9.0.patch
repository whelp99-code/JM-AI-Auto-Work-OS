-function micros(value: string): bigint {
-  if (!/^(0|[1-9][0-9]*)$/.test(value)) {
-    throw new Error("organization_invalid_micros");
-  }
-  return BigInt(value);
-}
-
-function subset(child: readonly string[], parent: readonly string[]): boolean {
-  const allowed = new Set(parent);
-  return child.every((value) => allowed.has(value));
-}
-
-function permissionRisk(permissions: readonly string[]): "GREEN" | "YELLOW" | "RED" {
-  if (
-    permissions.some(
-      (permission) =>
-        permission.startsWith("deploy:") ||
-        permission.startsWith("external:") ||
-        permission.startsWith("payment:") ||
-        permission.startsWith("credential:") ||
-        permission.startsWith("destructive:") ||
