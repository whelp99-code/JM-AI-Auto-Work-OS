-function reachable(
-  start: string,
-  target: string,
-  edgesFrom: ReadonlyMap<string, readonly GraphEdgeSpec[]>,
-  blockedNodes: ReadonlySet<string> = new Set()
-): boolean {
-  if (blockedNodes.has(start) || blockedNodes.has(target)) return false;
-  const pending = [start];
-  const visited = new Set<string>();
-
-  while (pending.length > 0) {
-    const current = pending.pop();
-
-    if (!current || visited.has(current) || blockedNodes.has(current)) continue;
-    if (current === target) return true;
-    visited.add(current);
-
-    for (const edge of edgesFrom.get(current) ?? []) {
-      if (!blockedNodes.has(edge.to)) pending.push(edge.to);
-    }
-  }
-
-  return false;
-}
-
-function allReachable(
-  start: string,
-  edgesFrom: ReadonlyMap<string, readonly GraphEdgeSpec[]>
-): Set<string> {
-  const output = new Set<string>();
-  const pending = [start];
-
-  while (pending.length > 0) {
-    const current = pending.pop();
-    if (!current || output.has(current)) continue;
-    output.add(current);
-
-    for (const edge of edgesFrom.get(current) ?? []) {
-      pending.push(edge.to);
-    }
-  }
-
-  return output;
-}
-
-function stronglyConnectedComponents(
-  nodeKeys: readonly string[],
-  edgesFrom: ReadonlyMap<string, readonly GraphEdgeSpec[]>
-): string[][] {
-  let nextIndex = 0;
-  const indexes = new Map<string, number>();
-  const lowLinks = new Map<string, number>();
-  const stack: string[] = [];
-  const onStack = new Set<string>();
-  const components: string[][] = [];
-
-  const visit = (nodeKey: string): void => {
-    indexes.set(nodeKey, nextIndex);
-    lowLinks.set(nodeKey, nextIndex);
-    nextIndex += 1;
-    stack.push(nodeKey);
-    onStack.add(nodeKey);
-
-    for (const edge of edgesFrom.get(nodeKey) ?? []) {
-      if (!indexes.has(edge.to)) {
-        visit(edge.to);
-        lowLinks.set(
-          nodeKey,
-          Math.min(
-            lowLinks.get(nodeKey) ?? 0,
-            lowLinks.get(edge.to) ?? 0
-          )
-        );
-      } else if (onStack.has(edge.to)) {
-        lowLinks.set(
-          nodeKey,
-          Math.min(
-            lowLinks.get(nodeKey) ?? 0,
-            indexes.get(edge.to) ?? 0
-          )
-        );
-      }
-    }
-
-    if (lowLinks.get(nodeKey) === indexes.get(nodeKey)) {
-      const component: string[] = [];
-
-      while (stack.length > 0) {
-        const popped = stack.pop();
-        if (!popped) break;
-        onStack.delete(popped);
-        component.push(popped);
-        if (popped === nodeKey) break;
-      }
-
-      components.push(component);
-    }
-  };
-
-  for (const nodeKey of nodeKeys) {
-    if (!indexes.has(nodeKey)) visit(nodeKey);
-  }
-
-  return components;
-}
-
-function toolPolicyViolations(node: GraphNodeSpec, capabilities: readonly string[]): string[] {
-  const capabilitySet = new Set(capabilities);
-  const violations: string[] = [];
-  const hasWrite =
-    capabilitySet.has("workspace_write") ||
-    capabilitySet.has("artifact_write") ||
-    capabilitySet.has("external_effect");
-
-  if (node.role === "verifier" && hasWrite) {
-    violations.push("verifier_must_be_read_only");
-  }
-
-  if (
-    node.role === "researcher" &&
-    (capabilitySet.has("workspace_write") ||
-      capabilitySet.has("external_effect") ||
-      capabilitySet.has("approval"))
-  ) {
-    violations.push("researcher_privilege_exceeds_policy");
-  }
-
-  if (
-    (node.role === "router" ||
-      node.role === "planner" ||
-      node.role === "risk_gate") &&
-    capabilitySet.has("external_effect")
-  ) {
-    violations.push("control_role_cannot_execute_external_effect");
-  }
-
-  if (node.kind === "approval" && !capabilitySet.has("approval")) {
-    violations.push("approval_node_requires_approval_capability");
-  }
-
-  return violations;
-}
