-export function compileGraphSpec(
-  spec: GraphSpecV1,
-  registry: GraphCompilerRegistry
-): GraphCompilationResult {
-  const issues: GraphCompilationIssue[] = [];
-
-  if (spec.schemaVersion !== "graph-spec.v1") {
-    issue(issues, "unsupported_schema_version", "GraphSpec schema version is not supported.");
-  }
-
-  if (!graphKeyPattern.test(spec.key)) {
-    issue(issues, "invalid_graph_key", "Graph key is invalid.");
-  }
-
-  if (!Number.isInteger(spec.version) || spec.version < 1 || spec.version > 1_000_000) {
-    issue(issues, "invalid_graph_version", "Graph version must be a positive integer.");
-  }
-
-  const limits = spec.limits;
-  const limitChecks: Array<[keyof typeof limits, number, number]> = [
-    ["maxTransitions", 1, 10_000],
-    ["maxIterations", 0, 1_000],
-    ["maxFanOut", 1, 32],
-    ["maxParallel", 1, 32],
-    ["sameFailureLimit", 1, 20]
-  ];
-
-  for (const [key, minimum, maximum] of limitChecks) {
-    const value = limits[key];
-    if (!Number.isInteger(value) || value < minimum || value > maximum) {
-      issue(issues, "invalid_graph_limit", `${key} must be between ${minimum} and ${maximum}.`);
-    }
-  }
-
-  if (spec.nodes.length < 2 || spec.nodes.length > 128) {
-    issue(issues, "invalid_node_count", "Graph must contain between 2 and 128 nodes.");
-  }
-
-  if (spec.edges.length < 1 || spec.edges.length > 512) {
-    issue(issues, "invalid_edge_count", "Graph must contain between 1 and 512 edges.");
-  }
-
-  const nodes = new Map<string, GraphNodeSpec>();
-
-  for (const node of spec.nodes) {
-    if (!identifierPattern.test(node.key)) {
-      issue(issues, "invalid_node_key", "Node key is invalid.", { nodeKey: node.key });
-    }
-
-    if (nodes.has(node.key)) {
-      issue(issues, "duplicate_node_key", "Node key must be unique.", { nodeKey: node.key });
-      continue;
-    }
-
-    nodes.set(node.key, node);
-
-    const identifiers: Array<[string, string]> = [
-      ["handler", node.handlerId],
-      ["input projector", node.inputProjectorId],
-      ["output schema", node.outputSchemaId],
-      ["tool policy", node.toolPolicyId],
-      ["retry policy", node.retryPolicyId]
-    ];
-
-    for (const [label, value] of identifiers) {
-      if (!identifierPattern.test(value)) {
-        issue(issues, "invalid_registry_identifier", `${label} identifier is invalid.`, {
-          nodeKey: node.key
-        });
-      }
-    }
-
-    const handlerContract = registry.handlerContracts[node.handlerId];
-    if (!registry.handlers.has(node.handlerId) || !handlerContract) {
-      issue(issues, "unknown_handler", `Handler ${node.handlerId} is not registered.`, {
-        nodeKey: node.key
-      });
-    } else {
-      if (node.kind !== handlerContract.kind) {
-        issue(issues, "handler_kind_mismatch", "Node kind does not match the registered handler contract.", { nodeKey: node.key });
-      }
-      if (node.role !== handlerContract.role) {
-        issue(issues, "handler_role_mismatch", "Node role does not match the registered handler contract.", { nodeKey: node.key });
-      }
-      if (node.inputProjectorId !== handlerContract.inputProjectorId) {
-        issue(issues, "handler_input_projector_mismatch", "Input projector does not match the registered handler contract.", { nodeKey: node.key });
-      }
-      if (node.outputSchemaId !== handlerContract.outputSchemaId) {
-        issue(issues, "handler_output_schema_mismatch", "Output schema does not match the registered handler contract.", { nodeKey: node.key });
-      }
-      if (node.toolPolicyId !== handlerContract.toolPolicyId) {
-        issue(issues, "handler_tool_policy_mismatch", "Tool policy does not match the registered handler contract.", { nodeKey: node.key });
-      }
-    }
-
-    if (!registry.inputProjectors.has(node.inputProjectorId)) {
-      issue(issues, "unknown_input_projector", `Input projector ${node.inputProjectorId} is not registered.`, {
-        nodeKey: node.key
-      });
-    }
-
-    if (!registry.outputSchemas.has(node.outputSchemaId)) {
-      issue(issues, "unknown_output_schema", `Output schema ${node.outputSchemaId} is not registered.`, {
-        nodeKey: node.key
-      });
-    }
-
-    if (!registry.retryPolicies.has(node.retryPolicyId)) {
-      issue(issues, "unknown_retry_policy", `Retry policy ${node.retryPolicyId} is not registered.`, {
-        nodeKey: node.key
-      });
-    }
-
-    if (node.modelPolicyId && !registry.modelPolicies.has(node.modelPolicyId)) {
-      issue(issues, "unknown_model_policy", `Model policy ${node.modelPolicyId} is not registered.`, {
-        nodeKey: node.key
-      });
-    }
-
-    const toolPolicy = registry.toolPolicies[node.toolPolicyId];
-    if (!toolPolicy) {
-      issue(issues, "unknown_tool_policy", `Tool policy ${node.toolPolicyId} is not registered.`, {
-        nodeKey: node.key
-      });
-    } else {
-      for (const violation of toolPolicyViolations(node, toolPolicy.capabilities)) {
-        issue(issues, violation, `Node role and tool policy are incompatible: ${violation}.`, {
-          nodeKey: node.key
-        });
-      }
-    }
-
-    if (node.kind === "terminal" && !node.terminalStatus) {
-      issue(issues, "terminal_status_required", "Terminal node must declare terminalStatus.", {
-        nodeKey: node.key
-      });
-    }
-
-    if (node.kind !== "terminal" && node.terminalStatus) {
-      issue(issues, "terminal_status_forbidden", "Only terminal nodes may declare terminalStatus.", {
-        nodeKey: node.key
-      });
-    }
-
-    if (node.kind === "fan_out") {
-      if (!node.fanOutTargetNodeKey || !node.joinNodeKey) {
-        issue(issues, "fan_out_contract_required", "Fan-out node must declare target and join nodes.", {
-          nodeKey: node.key
-        });
-      }
-    } else if (node.fanOutTargetNodeKey || node.joinNodeKey) {
-      issue(issues, "fan_out_contract_forbidden", "Only fan-out nodes may declare fan-out target or join.", {
-        nodeKey: node.key
-      });
-    }
-  }
-
-  if (!nodes.has(spec.startNode)) {
-    issue(issues, "start_node_missing", "Start node does not exist.");
-  }
-
-  const edgeKeys = new Set<string>();
-  const edgePriorities = new Set<string>();
-  const edgesFromMutable = new Map<string, GraphEdgeSpec[]>();
-
-  for (const edge of spec.edges) {
-    if (!identifierPattern.test(edge.key)) {
-      issue(issues, "invalid_edge_key", "Edge key is invalid.", { edgeKey: edge.key });
-    }
-
-    if (edgeKeys.has(edge.key)) {
-      issue(issues, "duplicate_edge_key", "Edge key must be unique.", { edgeKey: edge.key });
-      continue;
-    }
-    edgeKeys.add(edge.key);
-
-    if (!nodes.has(edge.from) || !nodes.has(edge.to)) {
-      issue(issues, "edge_endpoint_missing", "Edge endpoint does not exist.", {
-        edgeKey: edge.key
-      });
-      continue;
-    }
-
-    if (!registry.predicates.has(edge.predicateId)) {
-      issue(issues, "unknown_predicate", `Predicate ${edge.predicateId} is not registered.`, {
-        edgeKey: edge.key
-      });
-    }
-
-    if (!Number.isInteger(edge.priority) || edge.priority < 0 || edge.priority > 10_000) {
-      issue(issues, "invalid_edge_priority", "Edge priority must be a non-negative integer.", {
-        edgeKey: edge.key
-      });
-    }
-
-    const priorityKey = `${edge.from}:${edge.priority}`;
-    if (edgePriorities.has(priorityKey)) {
-      issue(issues, "duplicate_edge_priority", "Outgoing edge priorities must be unique.", {
-        edgeKey: edge.key
-      });
-    }
-    edgePriorities.add(priorityKey);
-
-    if (edge.loopGuardId && !registry.loopGuards.has(edge.loopGuardId)) {
-      issue(issues, "unknown_loop_guard", `Loop guard ${edge.loopGuardId} is not registered.`, {
-        edgeKey: edge.key
-      });
-    }
-
-    const list = edgesFromMutable.get(edge.from) ?? [];
-    list.push(edge);
-    edgesFromMutable.set(edge.from, list);
-  }
-
-  const edgesFrom = new Map<string, readonly GraphEdgeSpec[]>();
-  for (const [from, edges] of edgesFromMutable.entries()) {
-    edgesFrom.set(from, [...edges].sort((a, b) => a.priority - b.priority));
-  }
-
-  for (const node of nodes.values()) {
-    const outgoing = edgesFrom.get(node.key) ?? [];
-
-    if (node.childOnly) {
-      const incoming = spec.edges.filter((edge) => edge.to === node.key);
-      if (incoming.length > 0 || outgoing.length > 0) {
-        issue(issues, "child_node_must_be_detached", "Child-only nodes cannot participate in control edges.", {
-          nodeKey: node.key
-        });
-      }
-      continue;
-    }
-
-    if (node.kind === "terminal" && outgoing.length > 0) {
-      issue(issues, "terminal_has_outgoing_edge", "Terminal nodes cannot have outgoing edges.", {
-        nodeKey: node.key
-      });
-    }
-
-    if (node.kind !== "terminal" && outgoing.length === 0) {
-      issue(issues, "non_terminal_without_edge", "Non-terminal node requires an outgoing edge.", {
-        nodeKey: node.key
-      });
-    }
-
-    if (node.kind === "fan_out") {
-      const target = node.fanOutTargetNodeKey ? nodes.get(node.fanOutTargetNodeKey) : undefined;
-      const join = node.joinNodeKey ? nodes.get(node.joinNodeKey) : undefined;
-
-      if (!target?.childOnly) {
-        issue(issues, "fan_out_target_must_be_child", "Fan-out target must be a child-only node.", {
-          nodeKey: node.key
-        });
-      }
-
-      if (!join || join.kind !== "join" || join.childOnly) {
-        issue(issues, "fan_out_join_invalid", "Fan-out join node is missing or invalid.", {
-          nodeKey: node.key
-        });
-      }
-
-      if (node.joinNodeKey && !outgoing.some((edge) => edge.to === node.joinNodeKey)) {
-        issue(issues, "fan_out_join_edge_missing", "Fan-out node must transition directly to its join node.", {
-          nodeKey: node.key
-        });
-      }
-    }
-  }
-
-  const controlNodeKeys = [...nodes.values()]
-    .filter((node) => !node.childOnly)
-    .map((node) => node.key);
-  const reachableNodes = nodes.has(spec.startNode)
-    ? allReachable(spec.startNode, edgesFrom)
-    : new Set<string>();
-
-  for (const nodeKey of controlNodeKeys) {
-    if (!reachableNodes.has(nodeKey)) {
-      issue(issues, "unreachable_node", "Control node is unreachable from start.", {
-        nodeKey
-      });
-    }
-  }
-
-  // Every possible cycle must traverse a bounded edge. Merely requiring one
-  // guarded edge per strongly-connected component is insufficient because a
-  // smaller unguarded sub-cycle could bypass it. Remove guarded edges and
-  // require the remaining control graph to be acyclic.
-  const unguardedEdgesFrom = new Map<string, readonly GraphEdgeSpec[]>();
-  for (const [from, edges] of edgesFrom.entries()) {
-    unguardedEdgesFrom.set(
-      from,
-      edges.filter((edge) => !edge.loopGuardId)
-    );
-  }
-  const unguardedComponents = stronglyConnectedComponents(
-    controlNodeKeys,
-    unguardedEdgesFrom
-  );
-
-  for (const component of unguardedComponents) {
-    const onlyNode = component[0];
-    const cyclic =
-      component.length > 1 ||
-      (component.length === 1 &&
-        onlyNode !== undefined &&
-        (unguardedEdgesFrom.get(onlyNode) ?? []).some(
-          (edge) => edge.to === onlyNode
-        ));
-
-    if (cyclic) {
-      issue(
-        issues,
-        "unguarded_cycle",
-        `Cycle ${component.sort().join(",")} can execute without a bounded loop guard.`
-      );
-    }
-  }
-
-  if (
-    spec.edges.some((edge) => Boolean(edge.loopGuardId)) &&
-    (spec.limits.maxIterations < 1 || spec.limits.maxTransitions < 2)
-  ) {
-    issue(
-      issues,
-      "invalid_loop_limits",
-      "Graphs with retry edges require positive iteration and transition limits."
-    );
-  }
-
-  // Independent verification is a registered semantic capability, not a
-  // label a GraphSpec can self-assign. Only the immutable `verify` handler
-  // contract counts as a verifier. A node that merely claims the verifier role
-  // (or sets requiredVerification) is still rejected by the handler contract
-  // checks above and cannot satisfy the success-path gate.
-  const verifierNodes = new Set(
-    [...nodes.values()]
-      .filter((node) => node.handlerId === "verify")
-      .map((node) => node.key)
-  );
-  const finalGateNodes = new Set(
-    [...nodes.values()]
-      .filter((node) => node.handlerId === "final_gate")
-      .map((node) => node.key)
-  );
-  const approvalNodes = new Set(
-    [...nodes.values()]
-      .filter((node) => node.kind === "approval")
-      .map((node) => node.key)
-  );
-  const successTerminals = [...nodes.values()].filter(
-    (node) =>
-      node.kind === "terminal" &&
-      (node.terminalStatus === "completed" || node.terminalStatus === "simulated")
-  );
-
-  if (successTerminals.length === 0) {
-    issue(issues, "success_terminal_missing", "Graph requires a completed or simulated terminal.");
-  }
-
-  // Structural dominance alone is insufficient. A verifier/final gate can be
-  // present on the path while an unconditional or failure edge still promotes
-  // the run. Require the registered success predicate on every outgoing edge
-  // that can reach a successful terminal without crossing another equivalent
-  // gate. Failure/retry edges remain valid when they must return through a new
-  // verifier or final gate before success.
-  for (const verifierKey of verifierNodes) {
-    for (const edge of edgesFrom.get(verifierKey) ?? []) {
-      if (edge.predicateId === "verification_passed") continue;
-
-      for (const terminal of successTerminals) {
-        if (reachable(edge.to, terminal.key, edgesFrom, verifierNodes)) {
-          issue(
-            issues,
-            "verification_success_predicate_required",
-            "A verifier edge can reach success without the verification_passed predicate or another verifier.",
-            { nodeKey: verifierKey, edgeKey: edge.key }
-          );
-          break;
-        }
-      }
-    }
-  }
-
-  for (const finalGateKey of finalGateNodes) {
-    for (const edge of edgesFrom.get(finalGateKey) ?? []) {
-      if (edge.predicateId === "final_gate_passed") continue;
-
-      for (const terminal of successTerminals) {
-        if (reachable(edge.to, terminal.key, edgesFrom, finalGateNodes)) {
-          issue(
-            issues,
-            "final_gate_success_predicate_required",
-            "A final-gate edge can reach success without the final_gate_passed predicate or another final gate.",
-            { nodeKey: finalGateKey, edgeKey: edge.key }
-          );
-          break;
-        }
-      }
-    }
-  }
-
-  const irreversibleNodes = [...nodes.values()].filter(
-    (node) => node.effectRisk === "irreversible" && node.kind !== "approval"
-  );
-
-  for (const approvalKey of approvalNodes) {
-    for (const edge of edgesFrom.get(approvalKey) ?? []) {
-      if (edge.predicateId === "approval_approved") continue;
-
-      for (const irreversible of irreversibleNodes) {
-        if (reachable(edge.to, irreversible.key, edgesFrom, approvalNodes)) {
-          issue(
-            issues,
-            "approval_success_predicate_required",
-            "A non-approved approval edge can reach an irreversible node without another approval gate.",
-            { nodeKey: approvalKey, edgeKey: edge.key }
-          );
-          break;
-        }
-      }
-    }
-  }
-
-  for (const terminal of successTerminals) {
-    if (reachable(spec.startNode, terminal.key, edgesFrom, verifierNodes)) {
-      issue(issues, "verification_bypass", "A success path can bypass independent verification.", {
-        nodeKey: terminal.key
-      });
-    }
-
-    if (reachable(spec.startNode, terminal.key, edgesFrom, finalGateNodes)) {
-      issue(issues, "final_gate_bypass", "A success path can bypass the final gate.", {
-        nodeKey: terminal.key
-      });
-    }
-
-    // Requiring a verifier somewhere on the path is not sufficient. Any
-    // research, planning, implementation, workspace mutation, or external
-    // effect performed after the last independent verifier would make that
-    // verifier's result stale. Every such node must be followed by another
-    // verifier before a successful terminal can be reached.
-    for (const node of nodes.values()) {
-      if (node.childOnly || !reachableNodes.has(node.key)) continue;
-      const capabilities =
-        registry.toolPolicies[node.toolPolicyId]?.capabilities ?? [];
-      const invalidatesVerification =
-        node.role === "researcher" ||
-        node.role === "planner" ||
-        node.role === "specialist" ||
-        node.role === "developer" ||
-        capabilities.includes("workspace_write") ||
-        capabilities.includes("artifact_write") ||
-        capabilities.includes("external_effect");
-
-      if (
-        invalidatesVerification &&
-        reachable(node.key, terminal.key, edgesFrom, verifierNodes)
-      ) {
-        issue(
-          issues,
-          "verification_stale_after_mutation",
-          "A result-changing node can reach success without a subsequent independent verifier.",
-          { nodeKey: node.key }
-        );
-      }
-    }
-  }
-
-  for (const node of nodes.values()) {
-    if (node.effectRisk !== "irreversible" || node.kind === "approval") continue;
-
-    if (reachable(spec.startNode, node.key, edgesFrom, approvalNodes)) {
-      issue(
-        issues,
-        "approval_bypass",
-        "An irreversible node is reachable without a human approval node.",
-        { nodeKey: node.key }
-      );
-    }
-  }
-
-  if (issues.length > 0) {
-    return { ok: false, issues };
-  }
-
-  return {
-    ok: true,
-    compiled: {
-      spec,
-      specHash: graphHash(spec),
-      nodes,
-      edgesFrom
-    }
-  };
-}
-
-export function compileGraphSpecOrThrow(
-  spec: GraphSpecV1,
-  registry: GraphCompilerRegistry
-): CompiledGraph {
-  const result = compileGraphSpec(spec, registry);
-
-  if (!result.ok) throw new GraphCompilationError(result.issues);
-  return result.compiled;
-}
