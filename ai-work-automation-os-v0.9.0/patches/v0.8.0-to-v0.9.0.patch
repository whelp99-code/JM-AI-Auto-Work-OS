-    if (publishedAt !== null && Number.isNaN(Date.parse(publishedAt))) {
-      throw new GraphRoleContractError("research_source_date_invalid");
-    }
-    return {
-      url: parsed.toString(),
-      title: stringValue(item.title, "research_source_title_invalid", 1_000),
