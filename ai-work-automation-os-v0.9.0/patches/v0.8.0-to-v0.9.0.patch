-      const signal = decision.routeClass === "direct" ? "route_direct" : "route_complex";
-
-      return nodeResult({
-        output: { ...decision, projectedState },
-        stateDelta: {
-          classification: {
-            complexity: decision.complexity,
-            uncertainty: decision.uncertainty
-          },
-          route: {
-            class: decision.routeClass,
-            researchFanOut: decision.researchFanOut,
-            maxParallel: decision.maxParallel,
-            modelClass: decision.modelClass,
-            verificationProfile: decision.verificationProfile,
-            reasonCodes: decision.reasonCodes
-          },
-          verification: {
-            status: "not_run",
-            profile: decision.verificationProfile,
-            verifiedAtStateVersion: null,
-            targetHash: null
-          },
-          approval: {
-            required: decision.approvalRequired,
-            decisionId: null,
-            status: null,
-            scopeHash: null
