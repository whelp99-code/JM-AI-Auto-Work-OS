-export function evaluateTeamFormationRequest(input: {
-  request: TeamFormationRequestV1;
-  manager: OrganizationAgentSnapshot;
-  existingTeamKeys: readonly string[];
-  existingRoleKeys?: readonly string[];
-  currentTeamCount: number;
-  currentAgentCount: number;
-  managerDirectReportCount?: number;
-  departmentBudgetRemainingMicros: string;
-  policy: OrganizationPolicySnapshot;
-}): StaffingPolicyDecision {
-  const request = input.request;
-  const reasonCodes: string[] = [];
-
-  if (
-    request.schemaVersion !== "team-formation-request.v1" ||
-    request.requestKey.length === 0 ||
-    request.missionOrganizationId.length === 0 ||
-    request.requestedByAgentId.length === 0 ||
-    !/^(0|[1-9][0-9]*)$/.test(request.expectedCostMicros)
-  ) {
-    throw new Error("team_formation_request_invalid");
-  }
-
-  if (input.manager.status !== "active" || !input.manager.mayCreateTeams) {
-    return {
-      status: "rejected",
-      riskLevel: "RED",
-      reasonCodes: ["manager.team_creation_not_allowed"],
-      scopeHash: graphHash({ request, rejected: true }),
-      reusableAgentId: null,
-      effectiveCostMicros: request.expectedCostMicros
-    };
-  }
-  if (input.manager.departmentKey !== request.targetDepartmentKey) {
-    reasonCodes.push("manager.department_scope_mismatch");
-  }
-  if ((input.managerDirectReportCount ?? 0) >= input.manager.maxDirectReports) {
-    reasonCodes.push("manager.direct_report_limit_exceeded");
-  }
-  if (input.existingTeamKeys.includes(request.proposedTeam.key)) {
-    reasonCodes.push("team.key_duplicate");
-  }
-  if (input.currentTeamCount + 1 > input.policy.maxTeams) {
-    reasonCodes.push("organization.team_limit_exceeded");
-  }
-  if (input.currentAgentCount + request.proposedTeam.roles.length > input.policy.maxAgents) {
-    reasonCodes.push("organization.agent_limit_exceeded");
-  }
-
-  const team = request.proposedTeam;
-  if (
-    team.roles.length < team.minMembers ||
-    team.roles.length > team.maxMembers ||
-    team.minMembers < 1 ||
-    team.maxMembers < team.minMembers
-  ) {
-    reasonCodes.push("team.member_bounds_invalid");
-  }
-  const leads = team.roles.filter((role) => role.isLead);
-  if (leads.length !== 1) reasonCodes.push("team.lead_count_invalid");
-  const lead = leads[0];
-  if (lead && lead.reportsToRoleKey !== input.manager.roleKey) {
-    reasonCodes.push("team.lead_reporting_line_invalid");
-  }
-  if (input.policy.requireIndependentVerifier && !team.roles.some((role) => role.isVerifier)) {
-    reasonCodes.push("team.independent_verifier_missing");
-  }
-
-  const roleKeys = team.roles.map((role) => role.key);
-  if (new Set(roleKeys).size !== roleKeys.length) {
-    reasonCodes.push("team.role_key_duplicate");
-  }
-  if (input.existingRoleKeys?.some((key) => roleKeys.includes(key))) {
-    reasonCodes.push("organization.role_key_duplicate");
-  }
-
-  const allowedPermissions = new Set(input.policy.allowedPermissions);
-  const forbiddenPermissions = new Set(input.policy.forbiddenPermissions);
-  const teamRoleKeys = new Set(roleKeys);
-  for (const role of team.roles) {
-    if (!subset(role.authority, input.manager.authority)) {
-      reasonCodes.push("role.authority_escalation");
-    }
-    if (!subset(role.permissions, input.manager.permissions)) {
-      reasonCodes.push("role.permission_escalation");
-    }
-    if (role.mayCreateRoles && !input.manager.mayCreateRoles) {
-      reasonCodes.push("role.creation_authority_escalation");
-    }
-    if (role.mayCreateTeams && !input.manager.mayCreateTeams) {
-      reasonCodes.push("team.creation_authority_escalation");
-    }
-    if (micros(role.budgetAuthorityMicros) > micros(input.manager.budgetAuthorityMicros)) {
-      reasonCodes.push("role.budget_authority_escalation");
-    }
-    if (role.permissions.some((permission) => !allowedPermissions.has(permission))) {
-      reasonCodes.push("role.permission_not_allowed");
-    }
-    if (role.permissions.some((permission) => forbiddenPermissions.has(permission))) {
-      reasonCodes.push("role.permission_forbidden");
-    }
-    if (
-      role.isVerifier &&
-      role.permissions.some(
-        (permission) =>
-          permission.includes("write") ||
-          permission === "team:staff" ||
-          permission === "team:create"
-      )
-    ) {
-      reasonCodes.push("verifier.independence_violation");
-    }
-    if (role.reportsToRoleKey === null) {
-      reasonCodes.push("role.reporting_line_missing");
-    } else if (
-      role.reportsToRoleKey !== input.manager.roleKey &&
-      !teamRoleKeys.has(role.reportsToRoleKey)
-    ) {
-      reasonCodes.push("role.reporting_line_out_of_scope");
-    }
-    if (role.isVerifier && lead && role.reportsToRoleKey === lead.key) {
-      reasonCodes.push("verifier.reports_to_producer_lead");
-    }
-  }
-
-  const providedCapabilities = new Set(
-    team.roles.flatMap((role) => role.capabilities)
-  );
-  if (!team.requiredCapabilities.every((capability) => providedCapabilities.has(capability))) {
-    reasonCodes.push("team.capability_gap_unresolved");
-  }
-
-  const expectedCost = micros(request.expectedCostMicros);
-  if (expectedCost !== micros(team.budgetLimitMicros)) {
-    reasonCodes.push("team.budget_request_mismatch");
-  }
-  if (expectedCost > micros(input.departmentBudgetRemainingMicros)) {
-    reasonCodes.push("department.budget_insufficient");
-  }
-  if (expectedCost > micros(input.manager.budgetAuthorityMicros)) {
-    reasonCodes.push("manager.budget_authority_insufficient");
-  }
-  if (reasonCodes.length > 0) {
-    const uniqueReasonCodes = [...new Set(reasonCodes)].sort();
-    return {
-      status: "rejected",
-      riskLevel: uniqueReasonCodes.some((code) => code.includes("authority") || code.includes("permission")) ? "RED" : "YELLOW",
-      reasonCodes: uniqueReasonCodes,
-      scopeHash: graphHash({ request, reasonCodes: uniqueReasonCodes, status: "rejected" }),
-      reusableAgentId: null,
-      effectiveCostMicros: request.expectedCostMicros
-    };
-  }
-
-  const teamPermissions = team.roles.flatMap((role) => role.permissions);
-  let riskLevel = permissionRisk(teamPermissions);
-  if (request.duration === "persistent") riskLevel = highestRisk(riskLevel, "YELLOW");
-  if (expectedCost > micros(input.policy.autoApproveStaffingBelowMicros)) {
-    riskLevel = highestRisk(riskLevel, "YELLOW");
-  }
-  const status = riskLevel === "GREEN" ? "auto_approved" : "approval_required";
-
-  return {
-    status,
-    riskLevel,
-    reasonCodes: [status === "auto_approved" ? "team.within_delegated_policy" : "team.approval_required"],
-    scopeHash: graphHash({
-      request,
-      managerId: input.manager.id,
-      policyVersion: input.policy.policyVersion,
-      status,
-      riskLevel
-    }),
-    reusableAgentId: null,
-    effectiveCostMicros: request.expectedCostMicros
-  };
-}
