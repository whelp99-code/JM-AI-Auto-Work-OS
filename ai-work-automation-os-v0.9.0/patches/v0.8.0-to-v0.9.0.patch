-  map.set(compiled.plan.executiveRole.key, compiled.plan.executiveRole);
-  for (const department of compiled.plan.departments) {
-    map.set(department.leaderRole.key, department.leaderRole);
-    for (const team of department.teams) {
-      for (const role of team.roles) map.set(role.key, role);
-    }
-  }
