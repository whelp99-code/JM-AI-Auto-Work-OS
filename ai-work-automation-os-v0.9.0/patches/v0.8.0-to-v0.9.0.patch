-function toneFor(input: {
-  terminal: boolean;
-  runStatus: string;
-  pendingApprovals: number;
-  blockingFailures: number;
-}): WorkspaceTone {
-  if (input.runStatus === "failed" || input.blockingFailures > 0) return "danger";
-  if (input.pendingApprovals > 0 || input.runStatus === "blocked") return "warning";
-  if (input.terminal && ["completed", "simulated"].includes(input.runStatus)) return "success";
-  if (["running", "queued"].includes(input.runStatus)) return "info";
-  return "neutral";
-}
