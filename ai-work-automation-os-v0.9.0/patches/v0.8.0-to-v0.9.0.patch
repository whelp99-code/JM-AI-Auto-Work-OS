-export function buildWorkspaceSummary(input: {
-  run: unknown;
-  mission: unknown;
-  graph: unknown;
-  organization: unknown;
-  approvals: WorkspaceApproval[];
-  evidence: WorkspaceEvidenceItem[];
-  artifacts: WorkspaceArtifact[];
-}): WorkspaceSummary {
-  const run = asRecord(input.run);
-  const mission = asRecord(input.mission);
-  const graph = asRecord(input.graph);
-  const organization = asRecord(input.organization);
-  const workItems = asRecords(mission?.workItems);
-  const completedWorkItems = workItems.filter((item) =>
-    ["completed", "simulated"].includes(stringValue(item.status).toLowerCase())
-  ).length;
-  const totalWorkItems = workItems.length;
-  const blockingFailures = asRecords(graph?.failures).filter(
-    (failure) => failure.blocking === true && stringValue(failure.status) !== "resolved"
-  ).length;
-  const runStatus = stringValue(run?.status, "unknown").toLowerCase();
-  const missionStatus = stringValue(mission?.status, "unknown").toLowerCase();
-  const terminal = isTerminalWorkspaceRun(runStatus) || terminalMissionStatuses.has(missionStatus);
-  const pendingApprovals = input.approvals.length;
-  const graphBudget = asRecord(graph?.budget);
-  const organizationId = stringValue(organization?.id);
-
-  let progressPercent = totalWorkItems
-    ? Math.round((completedWorkItems / totalWorkItems) * 65)
-    : 0;
-  if (organizationId) progressPercent = Math.max(progressPercent, 20);
-  if (graph) progressPercent = Math.max(progressPercent, 30);
-  if (["verify", "verification", "diagnose", "final_gate", "verify_final"].some((value) =>
-    stringValue(graph?.currentNodeKey).includes(value)
-  )) {
-    progressPercent = Math.max(progressPercent, 75);
-  }
-  if (input.artifacts.length) progressPercent = Math.max(progressPercent, 90);
-  if (["completed", "simulated"].includes(runStatus) || ["completed", "simulated"].includes(missionStatus)) {
-    progressPercent = 100;
-  }
-  if (["partial", "blocked", "failed"].includes(runStatus)) {
-    progressPercent = Math.min(99, Math.max(progressPercent, 60));
-  }
-
-  let nextAction: WorkspaceSummary["nextAction"] = "wait";
-  let nextActionReason = "실행 상태가 갱신되기를 기다리고 있습니다.";
-
-  if (pendingApprovals > 0) {
-    nextAction = "approve";
-    nextActionReason = `${pendingApprovals}개의 승인 또는 확인이 필요합니다.`;
-  } else if (blockingFailures > 0) {
-    nextAction = "review_failure";
-    nextActionReason = `${blockingFailures}개의 차단 실패를 검토해야 합니다.`;
-  } else if (!organizationId && !terminal) {
-    nextAction = "provision_organization";
-    nextActionReason = "목표를 수행할 미션 조직을 구성할 수 있습니다.";
-  } else if (organizationId && stringValue(organization?.status) === "active" && !terminal) {
-    nextAction = "reconcile_capabilities";
-    nextActionReason = "현재 조직의 역량 갭을 점검할 수 있습니다.";
-  } else if (terminal && input.artifacts.length > 0) {
-    nextAction = "review_artifacts";
-    nextActionReason = "검증된 최종 산출물을 검토하십시오.";
-  } else if (terminal) {
-    nextAction = "complete";
-    nextActionReason = "실행이 종료되었습니다.";
-  }
-
-  return {
-    runStatus,
-    missionStatus,
-    currentStage: stringValue(mission?.currentStage, "unknown"),
-    currentNode: nullableString(graph?.currentNodeKey),
-    riskLevel: stringValue(mission?.riskLevel, "GREEN"),
-    progressPercent: Math.min(100, Math.max(0, progressPercent)),
-    completedWorkItems,
-    totalWorkItems,
-    pendingApprovals,
-    blockingFailures,
-    artifactCount: input.artifacts.length,
-    evidenceCount: input.evidence.length,
-    departmentCount: asRecords(organization?.departments).length,
-    teamCount: asRecords(organization?.teams).length,
-    agentCount: asRecords(organization?.agents).length,
-    budgetLimitMicros:
-      nullableString(graphBudget?.costLimitMicros) ??
-      nullableString(organization?.budgetLimitMicros),
-    budgetUsedMicros:
-      nullableString(graphBudget?.costUsedMicros) ??
-      nullableString(organization?.budgetUsedMicros),
-    nextAction,
-    nextActionReason,
-    tone: toneFor({ terminal, runStatus, pendingApprovals, blockingFailures }),
-    terminal
-  };
-}
