-async function ensureDefinition(
-  organizationId: string
-): Promise<GraphDefinition> {
-  const specJson = graphCanonicalJson(defaultGraphSpec);
-  const specHash = compiledDefaultGraph.specHash;
-  const policyVersion = getGraphPolicyVersion();
-  const existing = await prisma.graphDefinition.findUnique({
-    where: {
-      organizationId_key_version: {
-        organizationId,
-        key: defaultGraphSpec.key,
-        version: defaultGraphSpec.version
