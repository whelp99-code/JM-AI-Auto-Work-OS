-          }
-        }
-      });
-
-      if (!effect) throw new Error("external_effect_not_found");
-
-      const runIsActive =
-        effect.missionRun.status === "running" &&
-        effect.missionRun.leaseExpiresAt !== null &&
-        effect.missionRun.leaseExpiresAt.getTime() > now.getTime();
-
-      if (runIsActive) throw new Error("external_effect_active");
-
-      if (!["executing", "unknown", "failed"].includes(effect.status)) {
