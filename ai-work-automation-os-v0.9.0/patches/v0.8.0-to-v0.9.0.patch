-export async function reconcileMissionOrganizationCapabilities(input: {
-  missionOrganizationId: string;
-  actor: string;
-  maxRequests?: number;
-}): Promise<OrganizationCapabilityReconciliation> {
-  const maxRequests = Math.max(1, Math.min(input.maxRequests ?? 8, 64));
-  const organization = await prisma.missionOrganization.findUnique({
-    where: { id: input.missionOrganizationId },
-    include: {
-      departments: true,
-      teams: { orderBy: { key: "asc" } },
-      roleDefinitions: true,
-      agents: {
-        include: {
-          roleDefinition: true,
-          department: { select: { key: true } },
-          team: { select: { key: true } }
-        }
-      }
-    }
-  });
-  if (!organization) {
-    throw new OrganizationRuntimeError("mission_organization_not_found", 404);
-  }
-  if (organization.status !== "active" || organization.runtimeMode !== "active") {
-    throw new OrganizationRuntimeError("mission_organization_not_reconcilable", 409);
-  }
-
-  const result: OrganizationCapabilityReconciliation = {
-    missionOrganizationId: organization.id,
-    scannedTeams: 0,
-    detectedGaps: 0,
-    fulfilled: 0,
-    approvalRequired: 0,
-    unresolved: 0,
-    requests: []
-  };
-
-  for (const team of organization.teams) {
-    result.scannedTeams += 1;
-    const department = organization.departments.find(
-      (candidate) => candidate.id === team.departmentId
-    );
-    if (!department) continue;
-    const teamAgents = organization.agents.filter(
-      (agent) => agent.teamId === team.id && agent.status !== "retired"
-    );
-    const availableCapabilities = new Set(
-      teamAgents.flatMap((agent) => parseStoredStringArray(agent.capabilitiesJson, "agent_capabilities_corrupted"))
-    );
-    const gaps = parseStoredStringArray(team.requiredCapabilities, "team_capabilities_corrupted").filter(
-      (capability) => !availableCapabilities.has(capability)
-    );
-    result.detectedGaps += gaps.length;
-
-    for (const capability of gaps) {
-      if (result.requests.length >= maxRequests) {
-        result.unresolved += 1;
-        result.requests.push({
-          departmentKey: department.key,
-          teamKey: team.key,
-          capability,
-          managerAgentId: null,
-          requestId: null,
-          status: "unresolved",
-          reason: "reconciliation_request_limit_reached"
-        });
-        continue;
-      }
-
-      const verifier = capabilityRequiresIndependentVerifier(capability);
-      const managerRoleKey = verifier ? department.leaderRoleKey : team.leadRoleKey;
-      const manager = organization.agents.find(
-        (agent) =>
-          agent.roleDefinition.key === managerRoleKey &&
-          agent.status === "active"
-      );
-      if (!manager) {
-        result.unresolved += 1;
-        result.requests.push({
-          departmentKey: department.key,
-          teamKey: team.key,
-          capability,
-          managerAgentId: null,
-          requestId: null,
-          status: "unresolved",
-          reason: "capability_manager_not_available"
-        });
-        continue;
-      }
-
-      const remaining =
-        team.budgetLimitMicros - team.budgetReservedMicros - team.budgetUsedMicros;
-      if (remaining <= 0n) {
-        result.unresolved += 1;
-        result.requests.push({
-          departmentKey: department.key,
-          teamKey: team.key,
-          capability,
-          managerAgentId: manager.id,
-          requestId: null,
-          status: "unresolved",
-          reason: "team_budget_exhausted"
-        });
-        continue;
-      }
-      const expectedCost = remaining < 250_000n ? remaining : 250_000n;
-
-      let proposedRole: OrganizationRoleSpecV1 | null = null;
-      for (const definition of organization.roleDefinitions) {
-        if (definition.teamId !== team.id) continue;
-        const parsed = organizationRoleSpecSchema.safeParse(
-          parseStoredJson(definition.specJson, "role_definition_corrupted")
-        );
-        if (
-          parsed.success &&
-          parsed.data.capabilities.includes(capability) &&
-          parsed.data.reportsToRoleKey === managerRoleKey
-        ) {
-          proposedRole = parsed.data;
-          break;
-        }
-      }
-      proposedRole ??= buildCapabilityRoleProposal({
-        teamKey: team.key,
-        capability,
-        managerRoleKey,
-        budgetAuthorityMicros: expectedCost.toString(10),
-        verifier
-      });
-
-      try {
-        const request = await createMissionStaffingRequest({
-          missionOrganizationId: organization.id,
-          requestedByAgentId: manager.id,
-          targetDepartmentKey: department.key,
-          targetTeamKey: team.key,
-          reason: `Capability gap detected: ${capability}`,
-          missingCapabilities: [capability],
-          proposedRole,
-          expectedCostMicros: expectedCost.toString(10),
-          duration: "mission",
-          actor: input.actor
-        });
-        if (request.status === "fulfilled") result.fulfilled += 1;
-        else if (request.status === "approval_required") result.approvalRequired += 1;
-        else result.unresolved += 1;
-        result.requests.push({
-          departmentKey: department.key,
-          teamKey: team.key,
-          capability,
-          managerAgentId: manager.id,
-          requestId: request.id,
-          status: request.status,
-          reason: null
-        });
-      } catch (error) {
-        result.unresolved += 1;
-        result.requests.push({
-          departmentKey: department.key,
-          teamKey: team.key,
-          capability,
-          managerAgentId: manager.id,
-          requestId: null,
-          status: "unresolved",
-          reason: sanitizeOrganizationRuntimeError(error)
-        });
-      }
-    }
-  }
-
-  await prisma.$transaction(async (tx) => {
-    await createEvent(tx, organization.id, {
-      type: "organization.capabilities_reconciled",
-      actor: input.actor,
-      message: `Capability reconciliation scanned ${result.scannedTeams} teams and detected ${result.detectedGaps} gaps.`,
-      payload: result
-    });
-  }, { isolationLevel: Prisma.TransactionIsolationLevel.Serializable });
-
-  return result;
-}
