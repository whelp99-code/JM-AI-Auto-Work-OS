-import { isLocalDeploymentBrowser } from "@/lib/local/runtime";
-
-export const COMPANY_ACCESS_TOKEN_STORAGE_KEY = "company-access-token";
-export const COMPANY_LEGACY_TOKEN_STORAGE_KEY = "company-ceo-token";
-
-const MAX_BROWSER_TOKEN_LENGTH = 8_192;
-
-type BrowserCredentialStorage = Pick<Storage, "getItem">;
-
-type BrowserLocation = Pick<Location, "origin">;
-
-function normalizedStoredToken(
-  storage: BrowserCredentialStorage,
-  key: string
-): string | null {
-  let value: string | null;
-
-  try {
-    value = storage.getItem(key);
-  } catch {
-    return null;
-  }
-
-  const token = value?.trim() ?? "";
-
-  if (token.length < 1 || token.length > MAX_BROWSER_TOKEN_LENGTH) {
-    return null;
-  }
-
-  return token;
-}
-
-export function getCompanyBrowserCredentialHeaders(
-  storage?: BrowserCredentialStorage
-): Headers {
-  const headers = new Headers();
-
-  if (isLocalDeploymentBrowser() || !storage) return headers;
-
-  const accessToken = normalizedStoredToken(
-    storage,
-    COMPANY_ACCESS_TOKEN_STORAGE_KEY
-  );
-  const legacyToken = normalizedStoredToken(
-    storage,
-    COMPANY_LEGACY_TOKEN_STORAGE_KEY
-  );
-
-  if (accessToken) {
-    headers.set("Authorization", `Bearer ${accessToken}`);
-  } else if (legacyToken) {
-    headers.set("X-Company-CEO-Token", legacyToken);
-  }
-
-  return headers;
-}
-
-function currentSessionStorage(): BrowserCredentialStorage | undefined {
-  if (typeof window === "undefined") return undefined;
-
-  try {
-    return window.sessionStorage;
-  } catch {
-    return undefined;
-  }
-}
-
-function currentBrowserLocation(): BrowserLocation | undefined {
-  if (typeof window === "undefined") return undefined;
-  return window.location;
-}
-
-export function isCompanyApiRequest(
-  requestUrl: string,
-  location: BrowserLocation | undefined = currentBrowserLocation()
-): boolean {
-  if (!location) {
-    return requestUrl.startsWith("/api/company/") || requestUrl === "/api/company";
-  }
-
-  try {
-    const url = new URL(requestUrl, location.origin);
-    return (
-      url.origin === location.origin &&
-      (url.pathname === "/api/company" ||
-        url.pathname.startsWith("/api/company/"))
-    );
-  } catch {
-    return false;
-  }
-}
-
-export function withCompanyBrowserAuth(
-  requestUrl: string,
-  options: RequestInit = {},
-  storage: BrowserCredentialStorage | undefined = currentSessionStorage(),
-  location: BrowserLocation | undefined = currentBrowserLocation()
-): RequestInit {
-  const headers = new Headers(options.headers);
-
-  if (isCompanyApiRequest(requestUrl, location)) {
-    const credentialHeaders = getCompanyBrowserCredentialHeaders(storage);
-
-    credentialHeaders.forEach((value, name) => {
-      if (!headers.has(name)) headers.set(name, value);
-    });
-  }
-
-  return {
-    ...options,
-    headers
-  };
-}
