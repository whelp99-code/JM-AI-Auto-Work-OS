-  if (requested === "balanced") return ["balanced", "fast"];
-  return ["fast"];
-}
-
-export function selectGraphModel(input: {
-  registry: GraphModelRegistry;
-  role: GraphRole;
-  requestedClass: GraphModelClass;
-  estimatedInputTokens: number;
-  requestedOutputTokens: number;
-  remainingCostMicros: string;
-  allowClassDowngrade: boolean;
-  excludedEntryIds?: readonly string[];
-  preferredProviders?: readonly GraphModelProvider[];
-}): GraphModelSelection {
-  if (!liveGraphRoles.includes(input.role as LiveGraphRole)) {
-    throw new GraphModelRouterError("model_role_not_live");
-  }
-  if (!/^\d{1,30}$/.test(input.remainingCostMicros)) {
-    throw new GraphModelRouterError("model_remaining_budget_invalid");
-  }
-  const excluded = new Set(input.excludedEntryIds ?? []);
-  const providerRank = new Map(
-    (input.preferredProviders ?? []).map((provider, index) => [provider, index])
-  );
-  let sawConfigured = false;
-  let sawBudgetCandidate = false;
-
-  for (const modelClass of classCandidates(
-    input.requestedClass,
-    input.allowClassDowngrade
