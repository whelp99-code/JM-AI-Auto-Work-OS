-  policyVersion: string;
-  nodeKey: string;
-  actionKind: string;
-  target: string;
-  argumentsHash: string;
-  maximumCostMicros: string;
-  rollbackPlanHash: string;
-}): string {
-  return graphHash({ version: 1, ...input });
-}
