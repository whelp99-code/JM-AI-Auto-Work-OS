-  const now = new Date();
-  const actor = validatePrincipalId(input.actor);
-  const note = input.note.trim();
-  const providerRequestId = validatedProviderRequestId(input.providerRequestId);
-
-  if (note.length < 3 || note.length > 2_000 || /[\u0000-\u001F\u007F]/.test(note)) {
-    throw new Error("external_effect_reconciliation_note_invalid");
-  }
-
-  return prisma.$transaction(
-    async (tx) => {
-      const effect = await tx.externalEffect.findUnique({
-        where: { id: input.effectId },
-        include: {
-          missionRun: {
-            select: {
-              status: true,
-              leaseExpiresAt: true
