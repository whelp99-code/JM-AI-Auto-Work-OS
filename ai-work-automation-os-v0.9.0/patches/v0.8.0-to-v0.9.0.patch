-function validateEvidenceRefs(value: unknown): string[] {
-  const refs = stringArray(value, "role_evidence_refs_invalid", 200, 512);
-  if (refs.some((ref) => !identifierPattern.test(ref))) {
-    throw new GraphRoleContractError("role_evidence_refs_invalid");
-  }
-  return refs;
-}
