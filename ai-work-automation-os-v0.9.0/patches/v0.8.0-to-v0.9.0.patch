-  state: GraphStateV1;
-  predicates: GraphPredicateRegistry;
-}): SelectedGraphEdge {
-  const edges = input.compiled.edgesFrom.get(input.fromNodeKey) ?? [];
-  const evaluated: SelectedGraphEdge["evaluated"] = [];
-
-  for (const edge of edges) {
-    const predicate = input.predicates[edge.predicateId];
-
-    if (!predicate) {
-      throw new Error(`graph_predicate_not_available:${edge.predicateId}`);
-    }
-
-    let matched = false;
-
-    try {
-      matched = predicate(input.state) === true;
-    } catch {
-      matched = false;
-    }
-
-    evaluated.push({
-      edgeKey: edge.key,
-      predicateId: edge.predicateId,
-      matched
-    });
