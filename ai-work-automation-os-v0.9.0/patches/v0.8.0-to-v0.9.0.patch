-export function decideFailureRoute(input: {
-  failure: Pick<
-    GraphFailureSummary,
-    "failureType" | "occurrenceCount" | "retryable" | "severity"
-  >;
-  sameFailureLimit: number;
-  budgetExhausted: boolean;
-}): GraphFailureRoute {
-  if (input.budgetExhausted || input.failure.failureType === "budget_exceeded") {
-    return "partial";
-  }
-
-  if (
-    input.failure.failureType === "security_risk" ||
-    input.failure.failureType === "permission_risk"
-  ) {
-    return "human";
-  }
-
-  if (
-    input.failure.occurrenceCount >= input.sameFailureLimit ||
-    input.failure.severity === "critical"
-  ) {
-    return "human";
-  }
-
-  switch (input.failure.failureType) {
-    case "execution_error":
-      return input.failure.occurrenceCount >= 2 ? "plan" : "execute";
-    case "implementation_error":
-      // Legacy development-only failure route retained for resumable v1 runs.
-      return input.failure.occurrenceCount >= 2 ? "plan" : "develop";
-    case "design_error":
-      return input.failure.occurrenceCount >= 2 ? "human" : "plan";
-    case "requirements_ambiguity":
-      return "human";
-    case "evidence_gap":
-      return input.failure.occurrenceCount >= 2 ? "partial" : "research";
-    case "test_defect":
-      return input.failure.occurrenceCount >= 2 ? "human" : "verify";
-    case "tool_failure":
-    case "model_failure":
-      return input.failure.retryable ? "execute" : "failed";
-    case "unknown":
-      return input.failure.occurrenceCount >= 2 ? "human" : "plan";
-    default:
-      return "failed";
-  }
-}
