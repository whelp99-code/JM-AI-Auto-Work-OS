-
-  if (input.edge.loopGuardId) {
-    next.iteration.total += 1;
-    next.iteration.byNode[input.edge.to] =
-      (next.iteration.byNode[input.edge.to] ?? 0) + 1;
-
-    if (next.iteration.total > next.iteration.max) {
-      throw new Error("graph_iteration_limit_exceeded");
-    }
