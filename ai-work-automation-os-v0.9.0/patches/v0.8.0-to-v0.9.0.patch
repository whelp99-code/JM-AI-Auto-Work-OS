-        ? "retired"
-        : input.outcome === "completed"
-          ? "completed"
-          : "failed";
-    await tx.missionOrganization.update({
-      where: { id: organization.id },
-      data: {
-        status,
-        completedAt: new Date(),
-        retiredAt: remaining === 0 ? new Date() : null
-      }
-    });
-    await createEvent(tx, organization.id, {
-      type: "organization.mission_finalized",
-      actor: input.actor,
-      message: `Mission organization finalized with outcome ${input.outcome}.`,
-      payload: {
-        outcome: input.outcome,
-        assignmentStatus: terminalAssignmentStatus,
-        retiredAgentIds: temporaryAgents.map((agent) => agent.id),
-        remainingPersistentAgents: remaining,
-        status
